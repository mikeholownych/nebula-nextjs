{
  "name": "nebula-customer-portal",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "prebuild": "npm test -- --runInBand __tests__/teardown-screenshot-integrity.test.ts",
    "dev": "next dev --port 3000",
    "build": "node scripts/generate-build-info.mjs && node scripts/generate-learning-centre-md.mjs && next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test jest --runInBand",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:performance": "env -u NO_COLOR lhci collect && env -u NO_COLOR lhci assert && env -u NO_COLOR lhci upload",
    "check:sitemap-routes": "node scripts/check-sitemap-routes.mjs",
    "sync:citable": "node scripts/sync-citable-projection.mjs",
    "check:citable-projection": "node scripts/sync-citable-projection.mjs --check",
    "compile:evidence-atoms": "node scripts/compile-evidence-atoms.mjs",
    "check:evidence-atoms": "node scripts/compile-evidence-atoms.mjs --check",
    "compile:public-proof": "node scripts/compile-public-proof.mjs",
    "check:public-proof": "node scripts/compile-public-proof.mjs --check",
    "package:intelligence-stack": "node scripts/package-landing-page-intelligence-stack.mjs",
    "check:intelligence-stack": "node scripts/package-landing-page-intelligence-stack.mjs --check",
    "check:signal-canon": "node scripts/check-signal-canon.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:opportunity-governance": "node scripts/check-opportunity-governance.mjs",
    "check:content": "node scripts/check-banned-strings.mjs",
    "check:content-pipeline": "node scripts/run-content-pipeline-validation.mjs",
    "check:blog-content": "npm run check:content-pipeline",
    "check:brand": "node scripts/check-brand-projections.mjs",
    "check:analytics-governance": "node scripts/check-analytics-governance.mjs",
    "ci": "npm run typecheck && npm run lint && npm run check:content && npm run check:blog-content && npm run check:content-pipeline && npm run check:brand && npm run check:analytics-governance && npm run check:signal-canon && npm run check:claims && npm run check:opportunity-governance && npm run check:evidence-atoms && npm run check:public-proof && npm run check:citable-projection && npm run check:intelligence-stack && npm run build && npm run test && npm run test:e2e",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@heycatch/sdk": "^0.7.0",
    "@opinly/backend": "^1.4.0",
    "@posthog/nextjs-config": "^1.9.70",
    "@react-oauth/google": "^0.13.5",
    "@types/pdfkit": "^0.17.6",
    "@x402/core": "^2.23.0",
    "@x402/evm": "^2.23.0",
    "@x402/extensions": "^2.23.0",
    "@x402/next": "^2.23.0",
    "fast-xml-parser": "^5.11.0",
    "framer-motion": "^13.1.1",
    "geist": "^1.7.2",
    "lucide-react": "^1.33.0",
    "mppx": "^0.8.18",
    "next": "^16.3.2",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "posthog-js": "^1.418.6",
    "posthog-node": "^5.49.2",
    "prom-client": "^15.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "stripe": "^22.5.0",
    "svix": "^2.3.0",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-themes": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/nextjs": "^10.5.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.10",
    "fflate": "^0.8.3",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "postcss": "^8.5.26",
    "storybook": "^10.5.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "fast-uri": "^4.1.3",
    "sharp": "0.35.0",
    "next": {
      "postcss": "^8.5.26"
    }
  },
  "allowScripts": {
    "@posthog/cli@0.7.34": true
  }
}
