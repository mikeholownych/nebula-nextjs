# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-KJ9S3450LH
GA_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=[REDACTED]
STRIPE_WEBHOOK_SECRET=[REDACTED]
STRIPE_FIX_PACK_PRICE_ID=[REDACTED]

# PostgreSQL - discrete PG* vars (not a DATABASE_URL connection string)
PGHOST=/var/run/postgresql
PGPORT=5433
PGDATABASE=nebula_platform
PGUSER=postgres

# FastAPI platform-api backend
PLATFORM_API_URL=http://127.0.0.1:8001

# Authentication - JWT signing secret (shared with platform_api)
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth 2.0 (configured in Google Cloud Console)
# Callback URL (local): http://localhost:3000/api/auth/google
# Callback URL (prod):  https://nebulacomponents.com/api/auth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (configured in GitHub Developer Settings)
# Callback URL (local): http://localhost:8001/api/auth/github/callback
# Callback URL (prod):  https://nebulacomponents.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Internal service-to-service auth (e.g. app/api/email/process)
INTERNAL_API_SECRET=

# HMAC secret for signing audit-unlock cookies (app/lib/audit-unlock-token.ts)
AUDIT_UNLOCK_SECRET=

# RB2B webhook signature secret
RB2B_WEBHOOK_SECRET=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Site base URL - NEXT_PUBLIC_SITE_URL is canonical; NEXT_PUBLIC_BASE_URL and
# NEXT_PUBLIC_URL are legacy aliases (checkout reads SITE_URL first, then URL).
# NOTE: `next start` does NOT load the repo-root .env. In production these are
# injected via /etc/systemd/system/nebula-nextjs.service.d/site-url.conf -
# without that, fail-closed URL logic (e.g. /api/checkout) returns 503.
# All fall back to https://nebulacomponents.com if unset.
NEXT_PUBLIC_SITE_URL=https://nebulacomponents.com
NEXT_PUBLIC_BASE_URL=https://nebulacomponents.com
NEXT_PUBLIC_URL=https://nebulacomponents.com
