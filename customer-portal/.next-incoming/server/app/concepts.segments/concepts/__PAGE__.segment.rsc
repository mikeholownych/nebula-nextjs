d leading-relaxed max-w-2xl","children":"These are the concepts behind the 9-signal audit. Each term has a precise definition, a measurable standard, and a specific role in Nebula’s diagnostic output. Understanding them makes it easier to read an audit report, interpret a grade, and decide which finding to act on first."}]]}],["$","section",null,{"className":"mb-14 space-y-4","children":[["$","div","signal",{"id":"signal","className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"01"}],["$","div",null,{"children":[["$","h2",null,{"className":"text-base font-semibold text-fg","children":"Signal"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mt-1","children":"A single observable, measurable dimension of a landing page's conversion fitness. Nebula checks 9 signals per audit. Each has a defined pass standard and returns raw evidence."}]]}]]}],["$","div",null,{"className":"pl-7 space-y-3 mt-4","children":[["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-1","children":"Why it matters for conversion"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Breaking the audit into discrete signals makes findings falsifiable and actionable. A composite score without signal-level detail cannot tell you which element to fix - and fixing the wrong element wastes the budget."}]]}],["$","div",null,{"className":"border-l-2 border-accent/30 pl-4","children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-1","children":"How Nebula measures it"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"The engine evaluates each signal independently against the page's actual HTML response. Signals include: headline (H1 count, ICP clarity), CTA (label, above-fold visibility), social proof (source-order position, specificity), load speed (payload bytes, LCP proxy), and four others. Each returns pass or fail with the raw value that determined the result."}]]}]]}]]}],"$L2","$L3","$L4","$L5","$L6","$L7","$L8"]}],"$L9","$La"]}]}]],null,"$Lb"]}],"isPartial":"$@c","staleTime":"$d","varyParams":null},{"rsc":"$Le","isPartial":"$@f","staleTime":"$d","varyParams":null},{"rsc":"$L10","isPartial":"$@11","staleTime":"$d","varyParams":"$12"}],"isUpgradeableISRFallback":false,"a":"$@13","rootVaryParams":null,"needsRuntimeRequest":"$@14"}
