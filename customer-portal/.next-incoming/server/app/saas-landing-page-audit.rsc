28:["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Match the CTA to the actual sales motion. Self-serve: \"Start free\" or \"Try for free - no card required.\" Sales-assisted: \"See a demo.\" Do not mix both at equal visual weight in the hero."}]]}]
29:["$","div","2",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"03"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Above the fold"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"No product UI visible before scroll"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"Software is evaluated differently from physical products. A visitor cannot hold it, try it, or observe it passively. The fastest proxy for product confidence is a screenshot of the actual interface - not an illustration, not a diagram, not an icon grid. Pages that open with a stock gradient and a headline below it are asking visitors to take an action (sign up) before providing any evidence of what they are signing up for."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Put a real product screenshot above the fold. It does not need to be polished - a genuine interface view signals that the product exists and is specific. Crop to the most recognizable or impressive view."}]]}]]}]
2a:["$","div","3",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"04"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Social proof"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"Logo strip with no outcome context"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"A strip of company logos says \"organizations have used this.\" It does not say what changed for them. For cold traffic evaluating a software purchase, logos create no measurable reduction in perceived risk unless they are recognizable brands the visitor already trusts. A single named quote with a specific outcome (\"Closed 3 weeks of backlog in one sprint\") does more conversion work than 12 unnamed logos."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Replace or supplement the logo strip with one to three named quotes that include a specific, verifiable outcome. Job title and company are enough for attribution without requiring a case study."}]]}]]}]
2b:["$","div","4",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"05"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Load speed"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"JavaScript-heavy rendering delays LCP"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"SaaS pages frequently render the primary headline and CTA via JavaScript bundles. This means the page's most important content arrives late - or not at all for visitors on slow connections. It also means search engine crawlers and link previewers see a blank page. A missing H1 in static HTML (as observed on Calendly) is the most severe form of this problem."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Server-render the above-fold content. The H1, primary CTA, and value statement should be in the static HTML response. Run the audit and check the raw source: if the H1 count in static HTML is zero, the headline is rendering client-side."}]]}]]}]
2c:["$","div","5",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"06"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"SEO foundations"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"Title tag misaligned with H1 keyword"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"SaaS pages commonly run A/B tests by injecting both headline variants into the DOM simultaneously. This creates two H1 tags - both indexed by Google, both competing for the same ranking signal. Webflow's production page was observed with two H1 tags: \"Make your website a growth engine\" and \"Make websites that drive results.\" Neither can win because both dilute the signal for the other."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Run A/B tests at the edge or server layer - serve one variant per response. If running client-side A/B tests, ensure only one H1 is in the DOM at any time."}]]}]]}]
