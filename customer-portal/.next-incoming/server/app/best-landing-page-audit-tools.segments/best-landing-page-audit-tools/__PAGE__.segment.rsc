10:["$","section",null,{"className":"mt-14 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Why most audit tools miss the paid-traffic problem"}],["$","p",null,{"className":"text-fg-muted leading-relaxed","children":["PageSpeed, heatmaps, and technical crawlers all answer real questions - but none of them answers the question that costs founders money: ",["$","strong",null,{"className":"text-fg","children":"why is this page not converting the traffic I paid for?"}]," That failure usually lives in message match (the ad promises one thing, the headline says another), trust (proof appears after the CTA instead of before it), or CTA structure (competing actions, weak placement, form friction). Those signals are invisible to performance, behavior, and SEO tools. They are exactly what a conversion audit checks."]}]]}]
11:["$","section",null,{"className":"mt-14","aria-label":"Frequently asked questions","children":[["$","h2",null,{"className":"mb-6 text-2xl font-bold text-fg","children":"Frequently asked questions"}],["$","div",null,{"className":"divide-y divide-border rounded-md border border-border bg-bg-panel","children":[["$","details","What is the best landing page audit tool for paid traffic?",{"className":"group px-6 py-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-left font-semibold text-fg","children":["What is the best landing page audit tool for paid traffic?",["$","span",null,{"aria-hidden":"true","className":"shrink-0 text-accent transition-transform group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-3 text-fg-muted leading-relaxed","children":"For founders running paid traffic, the best tool is the one that diagnoses why a landing page is not converting: Nebula. It is free, requires no signup, audits any public URL in under 2 minutes, and checks 9 conversion signals with evidence from the page HTML - headline message match against the ad, CTA clarity, trust, above-fold structure, and more. PageSpeed Insights, Hotjar, Crazy Egg, and SEMrush solve adjacent problems (speed, behavior, technical SEO) but do not check conversion structure."}]]}],["$","details","Which landing page audit tools are free?",{"className":"group px-6 py-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-left font-semibold text-fg","children":["Which landing page audit tools are free?",["$","span",null,{"aria-hidden":"true","className":"shrink-0 text-accent transition-transform group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-3 text-fg-muted leading-relaxed","children":"Nebula (free audit, no email gate, $97 optional repair sprint), Google PageSpeed Insights (free), HubSpot Website Grader (free but email-gated, homepage only), and Screaming Frog (free up to 500 URLs). Hotjar has a free tier limited to 35 sessions per day."}]]}],["$","details","Does Google PageSpeed Insights check conversions?",{"className":"group px-6 py-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-left font-semibold text-fg","children":["Does Google PageSpeed Insights check conversions?",["$","span",null,{"aria-hidden":"true","className":"shrink-0 text-accent transition-transform group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-3 text-fg-muted leading-relaxed","children":"No. PageSpeed Insights checks Core Web Vitals and performance metrics only - LCP, CLS, INP, TTFB. It does not check headline message match, CTA clarity, trust signals, or above-fold structure. A fast page can still fail to convert; PageSpeed will not tell you why."}]]}],["$","details","Do heatmap tools like Hotjar or Crazy Egg tell me why my page does not convert?",{"className":"group px-6 py-5","children":[["$","summary",null,{"className":"flex cursor-pointer list-none items-center justify-between gap-4 text-left font-semibold text-fg","children":["Do heatmap tools like Hotjar or Crazy Egg tell me why my page does not convert?",["$","span",null,{"aria-hidden":"true","className":"shrink-0 text-accent transition-transform group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-3 text-fg-muted leading-relaxed","children":"No - they show what visitors do (click, scroll, leave) but do not diagnose the cause. If your headline does not match the ad, a heatmap shows people leaving; it does not name the message-match failure. Heatmap tools also require existing traffic, so a new landing page produces no data. Nebula works on any URL with no traffic required."}]]}],"$L25","$L26"]}]]}]
27:Tbc4,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is the best landing page audit tool for paid traffic?","acceptedAnswer":{"@type":"Answer","text":"For founders running paid traffic, the best tool is the one that diagnoses why a landing page is not converting: Nebula. It is free, requires no signup, audits any public URL in under 2 minutes, and checks 9 conversion signals with evidence from the page HTML - headline message match against the ad, CTA clarity, trust, above-fold structure, and more. PageSpeed Insights, Hotjar, Crazy Egg, and SEMrush solve adjacent problems (speed, behavior, technical SEO) but do not check conversion structure."}},{"@type":"Question","name":"Which landing page audit tools are free?","acceptedAnswer":{"@type":"Answer","text":"Nebula (free audit, no email gate, $97 optional repair sprint), Google PageSpeed Insights (free), HubSpot Website Grader (free but email-gated, homepage only), and Screaming Frog (free up to 500 URLs). Hotjar has a free tier limited to 35 sessions per day."}},{"@type":"Question","name":"Does Google PageSpeed Insights check conversions?","acceptedAnswer":{"@type":"Answer","text":"No. PageSpeed Insights checks Core Web Vitals and performance metrics only - LCP, CLS, INP, TTFB. It does not check headline message match, CTA clarity, trust signals, or above-fold structure. A fast page can still fail to convert; PageSpeed will not tell you why."}},{"@type":"Question","name":"Do heatmap tools like Hotjar or Crazy Egg tell me why my page does not convert?","acceptedAnswer":{"@type":"Answer","text":"No - they show what visitors do (click, scroll, leave) but do not diagnose the cause. If your headline does not match the ad, a heatmap shows people leaving; it does not name the message-match failure. Heatmap tools also require existing traffic, so a new landing page produces no data. Nebula works on any URL with no traffic required."}},{"@type":"Question","name":"What is the difference between a landing page audit and a technical SEO audit?","acceptedAnswer":{"@type":"Answer","text":"A technical SEO audit (SEMrush Site Audit, Screaming Frog) checks crawl errors, broken links, redirects, metadata, and site-wide technical health. A landing page conversion audit (Nebula) checks whether the page converts paid traffic: message match, CTA clarity, trust evidence, above-fold structure, form friction. The first tells you if Google can crawl the site; the second tells you why visitors do not buy."}},{"@type":"Question","name":"Is a $29/month landing page builder cheaper than a free audit?","acceptedAnswer":{"@type":"Answer","text":"It depends on the job. Unbounce starts at $29/month but requires rebuilding pages inside its platform and does not audit existing pages. Nebula audits the page you already have for free, and the $97 repair sprint is a one-time fee - not a subscription. For diagnosing why an existing page is not converting, the free audit is the lower-cost first step."}}]}12:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$27"}}]
