 font-semibold text-fg-muted mb-1","children":"Calendly"}],["$","p",null,{"className":"font-mono text-sm text-fg mb-2","children":"5.8/10 · C"}],["$","p",null,{"className":"text-xs text-fg-muted leading-5","children":"No H1 in static HTML. 1.2MB payload - 10× the heuristic ceiling."}],["$","p",null,{"className":"mt-3 text-xs font-semibold text-accent group-hover:text-fg transition-colors","children":"View full report →"}]]}]]}]]}]
