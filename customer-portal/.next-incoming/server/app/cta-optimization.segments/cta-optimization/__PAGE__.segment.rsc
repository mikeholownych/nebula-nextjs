4:["$","section",null,{"className":"mb-14","children":[["$","h2",null,{"className":"text-2xl font-bold tracking-tight text-fg mb-6","children":"Six CTA failures that block conversions"}],["$","div",null,{"className":"space-y-4","children":[["$","div","0",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"01"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"CTA Text"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"Label: 'Submit' - no outcome stated, describes the action not the result"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"'Submit', 'Learn More', and 'Get Started' all describe what the visitor does, not what they get. A visitor reading 'Submit' has no idea what changes after the click. The CTA label is the last line of your value proposition - it should confirm the specific result the visitor is about to receive. Generic labels create hesitation at exactly the moment you need commitment."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Replace the action verb with an outcome phrase. 'View the Evidence-Backed Audit Status' tells the visitor what they get and how fast. 'Start My Free Trial' confirms the offer type. Format: [action verb] + [specific result]. The fix takes 30 seconds to deploy and is measurable in the first 100 sessions."}]]}]]}],["$","div","1",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","childr