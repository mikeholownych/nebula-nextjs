visitor reaches the CTA. LCP over 2.5s, 400KB+ HTML payloads, render-blocking JavaScript, oversized images, and Cumulative Layout Shift each reduce conversion independently."}],["$","meta","12",{"name":"twitter:image","content":"https://nebulacomponents.com/brand/v2/og-default.png"}],["$","link","13",{"rel":"shortcut icon","href":"/favicon.svg"}],["$","link","14",{"rel":"icon","href":"/favicon.svg","type":"image/svg+xml"}],["$","link","15",{"rel":"icon","href":"/brand/v2/favicon-32.png","sizes":"32x32","type":"image/png"}],["$","link","16",{"rel":"icon","href":"/brand/v2/favicon-16.png","sizes":"16x16","type":"image/png"}],["$","link","17",{"rel":"apple-touch-icon","href":"/brand/v2/apple-touch-icon.png"}],["$","$L1e","18",{}]]}]}]}],["$","meta",null,{"name":"next-size-adjust","content":""}]]}]
