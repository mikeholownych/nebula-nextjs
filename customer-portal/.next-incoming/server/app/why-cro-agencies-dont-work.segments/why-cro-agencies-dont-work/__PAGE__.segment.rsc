10:["$","div","02",{"className":"rounded-md border border-border bg-bg-muted/20 p-6 md:p-8","children":[["$","div",null,{"className":"mb-4 flex items-start gap-4","children":[["$","span",null,{"className":"font-mono text-xs text-fg-muted shrink-0 mt-1","children":"02"}],["$","div",null,{"children":[["$","p",null,{"className":"mb-1 text-xs font-semibold uppercase tracking-wider text-accent","children":"Evidence standard"}],["$","h3",null,{"className":"text-lg font-bold text-fg","children":"Generic recommendations over specific findings"}]]}]]}],["$","p",null,{"className":"text-base text-fg-muted leading-7 mb-4","children":"\"Improve your CTA\" appears in every CRO report, written for every page, without reference to your actual CTA. The finding that matters is: \"Your primary CTA is below the fold on a 375px viewport. 64% of your paid traffic is mobile. The visitor never sees it.\" The first is advice. The second is evidence."}],["$","div",null,{"className":"border-l-2 border-accent/40 pl-4","children":["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":[["$","span",null,{"className":"font-semibold text-fg","children":"The alternative: "}],"Evidence-grade findings cite the source: the actual H1 text, the pixel dimensions, the character count, the specific element. You can verify every finding yourself by looking at the page source."]}]}]]}]
