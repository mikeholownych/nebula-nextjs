6:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How much does SEMrush cost?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"SEMrush Pro is $139.95/month and includes Site Audit as one module. There is no standalone Site Audit subscription. Nebula's audit is free; the repair sprint is a one-time $97.\"}},{\"@type\":\"Question\",\"name\":\"Does SEMrush Site Audit check conversions?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No - Site Audit runs technical SEO checks: crawl errors, broken links, redirects, metadata, Core Web Vitals. It does not check headline message match, CTA clarity, trust evidence, or above-fold structure.\"}},{\"@type\":\"Question\",\"name\":\"Is there a cheaper alternative to SEMrush for landing page conversion?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes - Nebula. Free instant audit with evidence per finding, plus a $97 one-time fix kit for the specific failing signals. SEMrush is $139.95/month for a platform you would only be using for one page.\"}}]}"}}]
