4:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-xl font-bold text-fg","children":["When ","Crazy Egg"," is still worth it"]}],["$","p",null,{"className":"text-fg-muted leading-relaxed","children":"Crazy Egg is worth it for growth teams with existing traffic who want heatmap and testing capability in one tool. For a single landing page that is not converting, a conversion audit is the higher-leverage first step."}]]}]
5:["$","section",null,{"className":"mt-12 rounded-2xl border border-accent/20 bg-accent/5 p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"The cheaper alternative: Nebula"}],["$","p",null,{"className":"text-fg leading-relaxed","children":"Nebula audits any public landing page in under 2 minutes - free, no signup, no credit card. It checks 9 observable page conditions: headline message match, CTA clarity, trust evidence, above-fold structure, mobile CTA, load speed, ad signals, SEO foundations, and AI citation readiness. The audit reports those page conditions. It does not predict conversion from paid traffic. When the audit finds failed conditions, the $97 one-time repair sprint writes the exact copy, code, or config changes for your page."}],["$","div",null,{"className":"mt-6 flex flex-wrap gap-3","children":[["$","$L2",null,{"href":"/audit?utm_source=pricing-guide&utm_medium=organic-content","className":"inline-block rounded bg-accent px-8 py-4 font-semibold text-bg hover:opacity-85 hover:bg-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg transition-colors","children":"Audit Your Page Free →"}],["$","$L2",null,{"href":"/vs/crazy-egg","className":"inline-block rounded border border-accent/40 px-8 py-4 font-semibold text-accent hover:bg-accent/10 transition-colors","children":["Full ","Crazy Egg"," vs. Nebula Comparison →"]}]]}]]}]
