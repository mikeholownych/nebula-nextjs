4:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-xl font-bold text-fg","children":["When ","Hotjar"," is still worth it"]}],["$","p",null,{"className":"text-fg-muted leading-relaxed","children":"Hotjar is worth it after you have traffic and want qualitative behavior data on top of a conversion diagnosis. For a new or low-traffic page, it produces almost nothing until sessions accumulate."}]]}]
