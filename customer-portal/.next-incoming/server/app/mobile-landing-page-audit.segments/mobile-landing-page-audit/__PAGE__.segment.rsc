10:["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"Google's Web Vitals standard and Apple's Human Interface Guidelines both specify 44×44 CSS pixels as the minimum touch target. Elements below this size cause two distinct failures: accidental taps on adjacent elements, and missed taps that register as no-action. On ecommerce pages, size and color variant selectors - typically rendered at 32–38px in default Shopify themes - are the most frequent violators. Icon-only buttons (wishlist hearts, share icons, close modals) are a close second."}]
11:["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Audit all interactive elements in Chrome DevTools with the Accessibility panel open. Set a minimum height and width of 44px on all buttons, links, and form controls. For icon-only buttons, increase the padding - not the icon size - to reach the minimum touch area without affecting visual design."}]]}]
12:["$","div","2",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"03"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Viewport meta"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"Missing or misconfigured viewport meta tag rendering desktop layout on mobile"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"A page without `<meta name='viewport' content='width=device-width, initial-scale=1'>` renders at desktop width on mobile browsers - typically 980px - and then scales down to fit the screen. The result is an unzoomed desktop layout where all text is illegible, all tap targets are tiny, and CTAs require precision tapping. This is a foundational configuration error that makes every other mobile fix irrelevant until it is corrected."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Add `<meta name='viewport' content='width=device-width, initial-scale=1'>` to the `<head>` of every landing page. Verify in Chrome DevTools that the device simulation renders the page at mobile width, not as a scaled-down desktop view. This is the first check in the mobile audit - if it fails, no other signal is evaluable."}]]}]]}]
13:["$","div","3",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"04"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Form friction"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"Multi-field forms with no autocomplete - email inputs missing type=\"email\""}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"Mobile form friction has two observable components. First: multi-field forms without `autocomplete` attributes force the visitor to type every field manually - name, email, company - on a touchscreen keyboard. Second: email inputs without `type='email'` do not trigger the email-optimized keyboard (with the @ symbol prominent) on iOS and Android. Both add friction that is invisible on desktop but material on mobile."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Add `autocomplete` attributes to every form field: `autocomplete='name'`, `autocomplete='email'`, `autocomplete='organization'`. Set `type='email'` on all email inputs and `type='tel'` on phone inputs. These attributes cost nothing to implement and directly reduce mobile form abandonment."}]]}]]}]
14:["$","div","4",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"05"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Image loading"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"Hero and product images loading at desktop resolution on mobile"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"A 1400×900 hero image loaded on a 375px mobile viewport delivers 2–4x the bytes the device can render. On a median 4G connection, a single oversized hero image adds 1–3 seconds to LCP. Most pages do not use `srcset` or `sizes` attributes to serve mobile-appropriate image dimensions - the same asset served to desktop users is served to mobile visitors at full resolution."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Implement responsive images using `srcset` and `sizes` attributes, or use a CDN that serves appropriately sized variants. A mobile hero image should be 750px wide at 2x for retina, not 1400px. Use WebP format. Verify in Chrome DevTools Network panel that the image loaded on mobile simulation is under 150KB for above-fold images."}]]}]]}]
15:["$","div","5",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"06"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Font size"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"Body text under 16px causing iOS to zoom on tap, breaking layout"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"iOS Safari auto-zooms into form inputs and interactive text elements when the font size is below 16px. This zoom behavior is a browser protection against illegible text - but it breaks the page layout for the visitor, requiring them to manually zoom out before continuing. Pages that set body text at 14px or 15px - common in design systems optimized for desktop - trigger this behavior on every form interaction on iOS."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Set the minimum font size for all text inputs and body text to 16px in your CSS. On iOS, this prevents the auto-zoom. Verify in Chrome DevTools device simulation and test on a real iPhone if available. The fix is a single CSS rule - it does not require a design overhaul."}]]}]]}]
