13:T58b,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How long does the free landing page audit take?","acceptedAnswer":{"@type":"Answer","text":"Under 2 minutes. Paste your URL and get a scored 9-signal diagnosis with findings ranked by priority."}},{"@type":"Question","name":"What's included in the $97 One-Leak Repair Sprint?","acceptedAnswer":{"@type":"Answer","text":"One landing page and one high-confidence audit finding. Nebula sends a tailored repair sprint after successful payment - exact copy, a code snippet, or a configuration change. No site access is required. You implement it yourself or hand it to your developer. Includes one same-scope re-audit within 30 days."}},{"@type":"Question","name":"Why do landing pages fail to convert paid traffic?","acceptedAnswer":{"@type":"Answer","text":"Most landing page failures follow diagnosable patterns: the ad promise does not match the page headline, no social proof appears above the fold, the CTA is hidden on mobile, the page loads too slowly, the primary action competes with secondary links, or the page lacks signals for AI and search discoverability."}},{"@type":"Question","name":"Do you need access to my website to run the audit?","acceptedAnswer":{"@type":"Answer","text":"No. We audit the public page. Just paste your URL - no login, dashboard access, or code repository is needed for the free audit."}}]}6:["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$13"}}],["$","main",null,{"id":"main-content","className":"min-h-screen bg-bg pt-24","children":[["$","$L14",null,{}],["$","$L15",null,{}],["$","section",null,{"className":"section-default","children":["$","div",null,{"className":"mx-auto max-w-6xl grid gap-10 md:grid-cols-2 md:items-start","children":[["$","div",null,{"children":[["$","h2",null,{"className":"heading-2 mb-6","children":"This is the output. Not a pitch deck."}],["$","p",null,{"className"