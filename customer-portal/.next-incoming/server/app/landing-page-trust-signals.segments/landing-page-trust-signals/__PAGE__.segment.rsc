3:["$","main",null,{"id":"main-content","className":"min-h-screen bg-bg pt-24 pb-16","children":["$","article",null,{"className":"mx-auto max-w-4xl px-6","children":[["$","header",null,{"className":"mb-12","children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-2","children":"Trust Signal Audit"}],["$","h1",null,{"className":"heading-1 text-fg md:text-5xl","children":"Add Proven Trust Signals to Boost Landing Page Conversions"}],["$","p",null,{"className":"mt-4 text-lg text-fg-muted leading-relaxed max-w-2xl","children":"Trust signal failures cost conversions on pages that are otherwise well-structured. Proof below the fold that cold traffic never reaches. Generic testimonials structurally identical to fabricated ones. No proof at all on pages running paid traffic. Each failure has a specific, observable form - and a bounded fix."}],["$","div",null,{"className":"mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3","children":[["$","$Le",null,{"href":"/audit?utm_source=lp-trust-hero&utm_medium=hero-cta","className":"inline-flex min-h-[44px] items-center justify-center rounded bg-accent px-6 py-3 text-sm font-semibold text-bg transition-opacity hover:opacity-85","children":"Get your free audit →"}],["$","$Le",null,{"href":"/repair-sprint","className":"inline-flex min-h-[44px] items-center justify-center rounded border border-border px-5 py-3 text-sm font-medium text-fg-muted transition-colors hover:border-fg-muted hover:text-fg","children":"Explore $97 Repair Sprint"}]]}]]}],["$","section",null,{"className":"mb-14","children":[["$","h2",null,{"className":"text-2xl font-bold tracking-tight text-fg mb-6","children":"Six trust signal failure patterns"}],["$","div",null,{"className":"space-y-4","children":[["$","div","0",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-