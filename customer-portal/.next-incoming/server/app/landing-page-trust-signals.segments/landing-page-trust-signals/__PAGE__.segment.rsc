18:["$","section",null,{"className":"mb-14","children":[["$","h2",null,{"className":"text-2xl font-bold tracking-tight text-fg mb-6","children":"Common questions"}],["$","div",null,{"className":"space-y-4","children":[["$","div","0",{"className":"rounded-xl border border-border bg-bg-muted/20 p-5","children":[["$","h3",null,{"className":"text-sm font-semibold text-fg mb-2","children":"What is the most effective type of social proof for a landing page?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Named quotes with specific, verifiable outcomes outperform all other formats for cold paid traffic. 'Increased trial-to-paid conversion by 34% in 6 weeks - Sarah M., Head of Growth, Acme' is more persuasive than 10 anonymous 5-star ratings because it provides a real person, a real outcome, and a falsifiable claim."}]]}],["$","div","1",{"className":"rounded-xl border border-border bg-bg-muted/20 p-5","children":[["$","h3",null,{"className":"text-sm font-semibold text-fg mb-2","children":"Where exactly should social proof be placed on a landing page?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Directly adjacent to the primary CTA - above it, beside it, or immediately below it. Proof at the bottom of the page, after the fold, reaches only the visitors who were already convinced. Cold traffic needs the proof before the ask."}]]}],["$","div","2",{"className":"rounded-xl border border-border bg-bg-muted/20 p-5","children":[["$","h3",null,{"className":"text-sm font-semibold text-fg mb-2","children":"How many trust signals do I need above the fold?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"The audit passes a page with 2 or more observable trust signals above the fold. More than that is fine; fewer than 2 creates a high-perceived-risk purchase environment for cold traffic."}]]}],["$","div","3",{"className":"rounded-xl border border-border bg-bg-muted/20 p-5","children":[["$","h3",null,{"className":"text-sm font-semibold text-fg mb-2","children":"Do security badges improve conversion?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Verified security badges (actual SSL certificate, actual BBB accreditation) provide modest lift for purchase pages. Generic 'Secure Checkout' badges created in Canva provide no measurable lift and can reduce trust among visitors who recognize them as unverifiable design elements."}]]}],["$","div","4",{"className":"rounded-xl border border-border bg-bg-muted/20 p-5","children":[["$","h3",null,{"className":"text-sm font-semibold text-fg mb-2","children":"What is 'proof type mismatch'?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Using the wrong type of social proof for your buyer's evaluation process. Consumer products benefit from aggregate star ratings and review counts. B2B products benefit from named company logos and specific outcome case studies. Coaching and consulting benefit from named testimonials with before/after context. Using aggregate star ratings on an enterprise software page signals that you don't understand how your buyer evaluates purchases."}]]}]]}]]}]
