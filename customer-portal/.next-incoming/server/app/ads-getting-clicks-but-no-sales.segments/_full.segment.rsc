29:["$","div",null,{"className":"mt-10 pt-8 border-t border-border/40 flex flex-col sm:flex-row items-center justify-between gap-4","children":[["$","p",null,{"className":"text-sm text-fg-muted","children":"Check your page against 9 conversion signals in under 2 minutes."}],["$","$L25",null,{"href":"/audit?utm_source=footer&utm_medium=internal","className":"btn-primary shrink-0 px-6 py-2.5 text-sm","children":"Get Your Free Audit →"}]]}]
2a:["$","div",null,{"className":"border-t border-border/20 px-6 py-4","children":["$","div",null,{"className":"mx-auto max-w-6xl flex flex-col md:flex-row justify-between items-center gap-2 text-xs text-fg-dim","children":[["$","p",null,{"children":["© ",2026," Nebula Components. All rights reserved."]}],["$","nav",null,{"aria-label":"Legal","className":"flex gap-4","children":[["$","$L25",null,{"href":"/privacy-policy","className":"hover:text-fg-muted transition-colors","children":"Privacy"}],["$","$L25",null,{"href":"/terms","className":"hover:text-fg-muted transition-colors","children":"Terms"}],["$","$L25",null,{"href":"/data-rights","className":"hover:text-fg-muted transition-colors","children":"Data Rights"}]]}]]}]}]
2e:["$","h3",null,{"className":"text-base font-semibold text-fg","children":"The ask on the page is larger than the ad implied"}]
2f:["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"The ad created an expectation about the size of the commitment - a low price, a free trial, a no-signup demo. The landing page presents a higher price, a required account creation, or an upsell before the primary action is available. This discrepancy registers as deception regardless of intent. Visitors do not re-evaluate - they leave. Checkout abandonment rates above 70% with a low-friction ad are the observable signature of this failure."}]
30:["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Align the commitment level on the page with the commitment level implied by the ad. If the ad says \"Try free,\" the page CTA says \"Try free.\" If pricing is higher than the ad implied, acknowledge the full offer structure immediately rather than surfacing it at checkout."}]]}]
31:["$","div","3",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"04"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Mobile CTA Visibility"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"60–80% of ad clicks are mobile - CTA is below the fold"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"Between 60 and 80 percent of paid social ad clicks originate on mobile devices. On a mobile viewport, a page designed primarily for desktop frequently pushes the primary CTA below a full screen of hero image, headline, and supporting copy. The visitor sees nothing actionable and scrolls - or does not scroll. Page designs with a sticky mobile CTA bar or a CTA within the first 600px of the mobile viewport convert at a measurably higher rate than pages where the first CTA appears at 900px or below."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Test your page on a 390px-wide mobile viewport. If the CTA button is not visible without scrolling, move it above the fold or implement a sticky bottom CTA bar for mobile breakpoints only."}]]}]]}]
32:["$","div","4",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"05"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Page Speed"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"LCP over 3 seconds - visitor left before the page rendered"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"Largest Contentful Paint (LCP) above 3 seconds correlates with a 32% increase in bounce rate relative to a 1-second LCP baseline (Google, 2018 - the absolute numbers have shifted but the direction has not changed). Ad traffic is particularly speed-sensitive: the visitor just tapped a small ad unit on a phone, they are mid-scroll, and any delay reactivates the back gesture. A page that loads slowly enough to show a white screen or a layout shift immediately after the click loses a significant fraction of paid clicks before a single word is read."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Run PageSpeed Insights on the exact landing page URL - not the homepage. LCP above 3s on mobile is the threshold for corrective action. Common causes: unoptimized hero image, render-blocking JavaScript, no CDN, third-party tag manager loading synchronously."}]]}]]}]
33:["$","div","5",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"06"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Ad Tracking"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"No conversion pixel on the page - ad platform optimizes toward clickers, not buyers"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"Without a conversion event firing on the post-purchase or post-signup page, the ad platform has no signal about which clicks resulted in transactions. It continues spending against clicks, not outcomes. Over time, the algorithm learns to target users who click ads - not users who buy. Campaigns without pixel-verified conversion events consistently show higher CPCs and lower ROAS than equivalent campaigns with verified conversion signals. The page may be converting some visitors while the platform bids against the wrong audience because it cannot see it."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Verify that the purchase or lead confirmation page fires a conversion event back to every active ad platform (Google Ads, Meta, LinkedIn, TikTok). Use each platform's tag diagnostic tool to confirm the event is received. Without this, spend optimization is guesswork."}]]}]]}]
