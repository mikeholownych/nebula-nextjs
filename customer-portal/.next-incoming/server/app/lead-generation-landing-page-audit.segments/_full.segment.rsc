1d:[["$","title","0",{"children":"Lead Gen Landing Page Audit: Fix Form & CTA Leaks | Nebula"}],["$","meta","1",{"name":"description","content":"Lead gen pages fail when cold-traffic forms ask too many questions, the submit button says \"Submit\", there is no proof adjacent to the form, and the visitor has no idea what happens after they click. This guide covers each failure with observable evidence and a bounded fix."}],["$","link","2",{"rel":"manifest","href":"/manifest.webmanifest","crossOrigin":"$undefined"}],["$","link","3",{"rel":"canonical","href":"https://nebulacomponents.com/lead-generation-landing-page-audit"}],["$","meta","4",{"property":"og:title","content":"Lead Gen Landing Page Audit: Fix Form & CTA Leaks | Nebula"}],["$","meta","5",{"property":"og:description","content":"Lead gen pages fail when cold-traffic forms ask too many questions, the submit button says \"Submit\", there is no proof adjacent to the form, and the visitor has no idea what happens after they click."}],["$","meta","6",{"property":"og:url","content":"https://nebulacomponents.com/lead-generation-landing-page-audit"}],["$","meta","7",{"property":"og:site_name","content":"Nebula Components"}],["$","meta","8",{"property":"og:type","content":"article"}],["$","meta","9",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","10",{"name":"twitter:creator","content":"@NebulaCRO"}],["$","meta","11",{"name":"twitter:title","content":"Find Failed Page Conditions on Your Landing Page | Nebula Components"}],["$","meta","12",{"name":"twitter:description","content":"Free landing page audit that finds failed page conditions on public HTML. Evidence-backed, no signup, results in under 2 minutes."}],["$","meta","13",{"name":"twitter:image","content":"https://nebulacomponents.com/brand/v2/og-default.png"}],["$","link","14",{"rel":"shortcut icon","href":"/favicon.svg"}],["$","link","15",{"rel":"icon","href":"/favicon.svg","type":"image/svg+xml"}],["$","link","16",{"rel":"icon","href":"/br