2f:["$","section",null,{"className":"mb-14 rounded-md border border-border bg-bg-muted/30 p-8 text-center","children":[["$","h2",null,{"className":"text-2xl font-bold text-fg mb-3","children":"Audit your lead generation page"}],["$","p",null,{"className":"text-sm text-fg-muted max-w-xl mx-auto mb-6","children":"Paste your URL. Nebula checks form field count, CTA label, proof placement, mobile form visibility, and post-submit clarity against your actual page - not a template. Free, no signup, under 2 minutes."}],["$","$L1f",null,{"href":"/audit?utm_source=content&utm_medium=organic-content","className":"inline-block rounded bg-accent px-8 py-4 font-semibold text-bg hover:opacity-85 hover:bg-accent transition-colors text-base","children":"Run Free Lead Gen Audit →"}]]}]
30:["$","section",null,{"className":"mb-14","children":[["$","h2",null,{"className":"text-2xl font-bold tracking-tight text-fg mb-6","children":"Common questions"}],["$","div",null,{"className":"space-y-4","children":[["$","div","0",{"className":"rounded-xl border border-border bg-bg-muted/20 p-5","children":[["$","h3",null,{"className":"text-sm font-semibold text-fg mb-2","children":"How many form fields is too many for a cold-traffic landing page?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Five or fewer for cold traffic. Name, email, and the minimum context needed to deliver what you promised. Company size, phone number, and budget questions belong on a qualification call, not the entry form. Every additional field you add to cold-traffic forms costs completions."}]]}],["$","div","1",{"className":"rounded-xl border border-border bg-bg-muted/20 p-5","children":[["$","h3",null,{"className":"text-sm font-semibold text-fg mb-2","children":"What should the form submit button say?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"It should state what the visitor receives, not what they're doing. 'Submit' and 'Send' describe the visitor's action. 'Get my free audit', 'Book the call', 'Start my trial' describe the outcome. The outcome framing converts better because it reminds the visitor why they're filling out the form."}]]}],["$","div","2",{"className":"rounded-xl border border-border bg-bg-muted/20 p-5","children":[["$","h3",null,{"className":"text-sm font-semibold text-fg mb-2","children":"Does removing the phone number field actually increase form completions?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Yes, consistently. Phone number is the single highest-friction field on lead gen forms for cold traffic. Unless phone is required for your delivery workflow, remove it from the entry form and collect it on a follow-up step after the initial conversion."}]]}],["$","div","3",{"className":"rounded-xl border border-border bg-bg-muted/20 p-5","children":[["$","h3",null,{"className":"text-sm font-semibold text-fg mb-2","children":"Where should social proof be placed on a lead gen landing page?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Adjacent to the form, not below it. A testimonial or client logo strip positioned directly above or beside the submit button acts at the moment of commitment - when trust is most needed. Proof at the bottom of the page, after the CTA, is too late for the visitors who abandoned without scrolling."}]]}],["$","div","4",{"className":"rounded-xl border border-border bg-bg-muted/20 p-5","children":[["$","h3",null,{"className":"text-sm font-semibold text-fg mb-2","children":"What is 'post-submit clarity' and why does it matter?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"It's the statement of what happens after the visitor clicks submit. 'We'll be in touch' creates anxiety - when? From whom? For what? 'You'll receive your report in 2 minutes by email' eliminates the uncertainty. Visitors who know exactly what to expect immediately after submitting are less likely to abandon the thank-you page or mark the follow-up as spam."}]]}]]}]]}]
