1e:["$","section",null,{"className":"mb-12 border-t border-border pt-12","children":[["$","h2",null,{"className":"text-2xl font-bold text-fg mb-6","children":"Frequently Asked Questions"}],["$","div",null,{"className":"space-y-6","children":[["$","div","Why am I getting clicks on my ads but zero conversions?",{"className":"rounded-xl border border-border p-5 bg-bg-muted/10","children":[["$","h3",null,{"className":"font-semibold text-fg text-base mb-2","children":"Why am I getting clicks on my ads but zero conversions?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-relaxed","children":"A click proves ad relevance, but conversion depends on post-click continuity. The most common causes are message mismatch between the ad promise and page headline, missing social proof above the fold, mobile rendering bottlenecks, or excessive form fields."}]]}],["$","div","Can an automated audit tell me if my traffic is low quality?",{"className":"rounded-xl border border-border p-5 bg-bg-muted/10","children":[["$","h3",null,{"className":"font-semibold text-fg text-base mb-2","children":"Can an automated audit tell me if my traffic is low quality?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-relaxed","children":"No. An automated page audit evaluates observable DOM and HTML conditions on your public URL. It cannot measure ad account audience selection, search intent, or traffic quality. It surfaces page-level friction candidates so you can rule out page defects first."}]]}],["$","div","What should I fix first if my page is not converting?",{"className":"rounded-xl border border-border p-5 bg-bg-muted/10","children":[["$","h3",null,{"className":"font-semibold text-fg text-base mb-2","children":"What should I fix first if my page is not converting?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-relaxed","children":"First, check message match: ensure your landing page H1 repeats the exact promise made in your ad creative. Second, ensure a clear primary call to action is visible on mobile viewports without scrolling. Third, place verifiable trust signals directly adjacent to the CTA."}]]}],["$","div","What is a good landing page conversion rate?",{"className":"rounded-xl border border-border p-5 bg-bg-muted/10","children":[["$","h3",null,{"className":"font-semibold text-fg text-base mb-2","children":"What is a good landing page conversion rate?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-relaxed","children":"Across industries, the median landing page conversion rate is roughly 4-5% for top-quartile pages, with the overall average closer to 2-3%. Paid traffic pages should be judged against their own ad spend, not a universal benchmark. If you are at 1% or below with paid traffic, page-level friction is usually the first place to look."}]]}],["$","div","How much does page speed affect conversion rate?",{"className":"rounded-xl border border-border p-5 bg-bg-muted/10","children":[["$","h3",null,{"className":"font-semibold text-fg text-base mb-2","children":"How much does page speed affect conversion rate?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-relaxed","children":"Published research consistently links load time to conversion. For example, Google reports that as page load time goes from 1 to 3 seconds, the probability of bounce increases by roughly 32%. On mobile, 53% of visits are abandoned if a page takes longer than 3 seconds to load. Speed is a conversion factor, not just an SEO factor."}]]}],["$","div","Should I rebuild my landing page or fix what I have?",{"className":"rounded-xl border border-border p-5 bg-bg-muted/10","children":["$L29","$L2a"]}]]}]]}]
