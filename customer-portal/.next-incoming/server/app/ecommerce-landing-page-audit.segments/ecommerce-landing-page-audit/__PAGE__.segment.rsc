5:["$","p",null,{"className":"mt-4 text-lg text-fg-muted leading-relaxed max-w-2xl","children":"Product pages receiving paid Meta and Google traffic fail for specific, observable reasons. Product-name H1s where the benefit should be. Price and shipping hidden until checkout. A buy button that competes with three other actions at equal weight. This guide covers each failure pattern with the signal it trips and a bounded fix."}]
6:["$","div",null,{"className":"mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3","children":[["$","$L16",null,{"href":"/audit?utm_source=ecom-audit-hero&utm_medium=hero-cta","className":"inline-flex min-h-[44px] items-center justify-center rounded bg-accent px-6 py-3 text-sm font-semibold text-bg transition-opacity hover:opacity-85","children":"Get your free audit →"}],["$","$L16",null,{"href":"/repair-sprint","className":"inline-flex min-h-[44px] items-center justify-center rounded border border-border px-5 py-3 text-sm font-medium text-fg-muted transition-colors hover:border-fg-muted hover:text-fg","children":"Explore $97 Repair Sprint"}]]}]
7:["$","section",null,{"className":"mb-14","children":[["$","h2",null,{"className":"text-2xl font-bold tracking-tight text-fg mb-6","children":"Six ecommerce-specific conversion failures"}],["$","div",null,{"className":"space-y-4","children":[["$","div","0",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"01"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Headline (H1)"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"Product name as H1 instead of outcome or benefit"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"Most product pages set the H1 to the product SKU or name - 'Blue Linen Shirt' - which tells a visitor what the product is called, not why it solves their problem. Cold paid traffic arriving from an ad that promised a specific benefit expects the page headline to confirm that benefit immediately. A product-name H1 is a mismatch between the ad promise and the landing page confirmation."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Reframe the H1 around the buyer's outcome. 'The linen shirt that breathes - even in August' communicates the benefit and extends the ad's promise. The product name can appear as a subtitle or in the breadcrumb. Test the new H1 against the exact ad copy that drove the click."}]]}]]}],["$","div","1",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"classN