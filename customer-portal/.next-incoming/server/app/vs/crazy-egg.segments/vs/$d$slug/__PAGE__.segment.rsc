b:["$","section",null,{"className":"mt-12 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-xl font-bold text-fg","children":"Bottom line"}],["$","p",null,{"className":"text-fg-muted leading-relaxed","children":"Crazy Egg is a solid visual analytics tool for teams who already have traffic and want to understand how users interact with a page. It observes actual user behavior. Nebula evaluates page-side structural conditions - whether the headline matches the ad, whether trust signals are visible, whether the CTA is above the fold - without requiring traffic data. Crazy Egg confirms that people leave; Nebula checks which structural conditions are failing. Different evidence, different timing."}]]}]
