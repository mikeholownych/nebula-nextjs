2b:["$","div",null,{"className":"border-t border-border/20 px-6 py-4","children":["$","div",null,{"className":"mx-auto max-w-6xl flex flex-col md:flex-row justify-between items-center gap-2 text-xs text-fg-dim","children":[["$","p",null,{"children":["© ",2026," Nebula Components. All rights reserved."]}],["$","nav",null,{"aria-label":"Legal","className":"flex gap-4","children":[["$","$L26",null,{"href":"/privacy-policy","className":"hover:text-fg-muted transition-colors","children":"Privacy"}],["$","$L26",null,{"href":"/terms","className":"hover:text-fg-muted transition-colors","children":"Terms"}],["$","$L26",null,{"href":"/data-rights","className":"hover:text-fg-muted transition-colors","children":"Data Rights"}]]}]]}]}]
2f:["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"Two pricing surprises hurt ecommerce conversions: the price appearing only after variant selection, and the shipping cost appearing only at checkout. Both are friction patterns that require the visitor to commit additional steps before receiving information they need to make a purchase decision. Paid traffic is already costly - the visitor's first qualification question is almost always 'how much is this?'"}]
30:["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Display the price - including a shipping estimate or free shipping threshold - above the fold, before the Add to Cart button. If shipping varies, show the range or the free shipping threshold. Do not defer this information to checkout."}]]}]
31:["$","div","3",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"04"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"CTA"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"'Add to Cart' competing with 'Save to Wishlist' and 'Compare' at equal visual weight"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"Product pages frequently present 3-4 actions - Add to Cart, Save to Wishlist, Compare, Share - at identical size, color, and position. A visitor who cannot immediately identify the primary action is not deciding to buy - they are deciding which button to interpret. Decision paralysis on a CTA is a design failure, not a visitor failure."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"One primary CTA, high contrast, full-width on mobile. Wishlist, Compare, and Share become icon buttons or links - smaller, muted, never competing visually with the buy action. The hierarchy of visual weight should match the hierarchy of business intent."}]]}]]}]
32:["$","div","4",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"05"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Mobile"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"Image gallery requiring pinch-zoom - variant selectors under 44px"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"On mobile, a product gallery that requires pinch-to-zoom to see detail signals that the page was not designed for the device the visitor is using. Simultaneously, variant selector buttons - size, color, material - on most Shopify themes are rendered at 32–38px touch targets, below the 44px minimum required for reliable tap interaction. Both failures compound on the same page."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Implement swipeable gallery with at least 3 angles natively navigable by swipe - no zoom required to see product detail. Render variant selectors at minimum 44×44px with visible selected state. Test on a 375px viewport before shipping."}]]}]]}]
33:["$","div","5",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"06"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Load speed"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"Product pages with 8-12 JS bundles delay LCP past 4s on mobile"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"Shopify's default themes load 8–12 JavaScript bundles on product pages - reviews widgets, chat plugins, upsell apps, loyalty programs - each blocking or competing for render bandwidth. On a median 4G connection, LCP for these pages exceeds 4 seconds. Google's threshold for good LCP is 2.5s. Pages above 4s lose a measurable share of mobile visitors before the page is usable."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Audit active Shopify apps and remove any whose JS loads on the product page but provides no above-fold value. Defer non-critical scripts. Target LCP under 2.5s on simulated 4G in Chrome DevTools. Each app removed from the bundle reduces the LCP window."}]]}]]}]
34:["$","p",null,{"className":"text-xs text-fg-muted leading-5","children":[["$","span",null,{"className":"text-signal-fail","children":"Fail: "}],"8+ JS bundles pushing LCP past 4s"]}]
