21:["$","section",null,{"className":"mt-14 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Why pricing matters when you are bleeding ad spend"}],["$","p",null,{"className":"text-fg-muted leading-relaxed","children":"A founder running paid traffic to a page that does not convert is paying twice: the ad cost every day, and a subscription for a tool that does not diagnose the actual problem. Before you add a recurring bill, run a free conversion audit. If the leak is message match, CTA, or trust - the most common causes - no heatmap or SEO crawl will name it. The fix is usually a one-time change, not a monthly platform."}]]}]
