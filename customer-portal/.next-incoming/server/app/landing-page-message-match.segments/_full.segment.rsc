24:["$","div",null,{"className":"border-t border-border/20 px-6 py-4","children":["$","div",null,{"className":"mx-auto max-w-6xl flex flex-col md:flex-row justify-between items-center gap-2 text-xs text-fg-dim","children":[["$","p",null,{"children":["© ",2026," Nebula Components. All rights reserved."]}],["$","nav",null,{"aria-label":"Legal","className":"flex gap-4","children":[["$","$L1f",null,{"href":"/privacy-policy","className":"hover:text-fg-muted transition-colors","children":"Privacy"}],["$","$L1f",null,{"href":"/terms","className":"hover:text-fg-muted transition-colors","children":"Terms"}],["$","$L1f",null,{"href":"/data-rights","className":"hover:text-fg-muted transition-colors","children":"Data Rights"}]]}]]}]}]
