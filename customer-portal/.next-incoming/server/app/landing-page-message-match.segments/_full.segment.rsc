18:["$","main",null,{"id":"main-content","className":"min-h-screen bg-bg pt-24 pb-16","children":["$","article",null,{"className":"mx-auto max-w-4xl px-6","children":[["$","header",null,{"className":"mb-12","children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-2","children":"Message Match Audit"}],["$","h1",null,{"className":"heading-1 text-fg md:text-5xl","children":"Improve Message Match to Boost Paid Traffic Conversions"}],["$","p",null,{"className":"mt-4 text-lg text-fg-muted leading-relaxed max-w-2xl","children":"Message match failures waste correctly targeted clicks. The ad brought the right visitor - the page failed to keep them. Keyword mismatch. Offer mismatch. Wrong ICP in the headline. Urgent ad creative landing on corporate brand language. Each mismatch is observable, measurable, and fixable."}],["$","div",null,{"className":"mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3","children":[["$","$L1f",null,{"href":"/audit?utm_source=lp-mm-hero&utm_medium=hero-cta","className":"inline-flex min-h-[44px] items-center justify-center rounded bg-accent px-6 py-3 text-sm font-semibold text-bg transition-opacity hover:opacity-85","children":"Get your free audit →"}],["$","$L1f",null,{"href":"/repair-sprint","className":"inline-flex min-h-[44px] items-center justify-center rounded border border-border px-5 py-3 text-sm font-medium text-fg-muted transition-colors hover:border-fg-muted hover:text-fg","children":"Explore $97 Repair Sprint"}]]}]]}],["$","section",null,{"className":"mb-14","children":[["$","h2",null,{"className":"text-2xl font-bold tracking-tight text-fg mb-6","children":"Six message match failure patterns"}],["$","div",null,{"className":"space-y-4","children":[["$","div","0",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"01"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Headline (H1)"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"Keyword mismatch - ad targets one term, page headline addresses another"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"An ad targeting 'landing page audit tool' brings a visitor to a page whose H1 reads 'Conversion optimization platform'. These are not the same thing to the visitor. They clicked expecting a tool for auditing landing pages and arrived at a platform for optimizing conversion - a category that could mean anything. The visitor must re-evaluate whether this page addresses their search intent before proceeding. This re-evaluation creates an exit opportunity that did not exist in the ad. The click was correctly targeted. The page wasted it."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"The H1 must contain the core promise from the ad within the first 6 words. If the ad says 'landing page audit', the H1 should say 'landing page audit'. The phrasing can vary - 'Free landing page audit', 'landing page audit' - but the central keyword must be present and prominent. Check that the H1 matches the title tag, which should also contain the ad's core keyword."}]]}]]}],["$","div","1",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":["$L28","$L29"]}],"$L2a","$L2b"]}],"$L2c","$L2d","$L2e","$L2f"]}]]}],"$L30","$L31","$L32","$L33"]}]}]
