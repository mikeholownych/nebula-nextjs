11:["$","div","2",{"className":"rounded border border-accent/20 bg-accent/5 p-6","children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wide text-accent mb-1","children":["Cause ","2"]}],["$","h3",null,{"className":"text-lg font-bold text-fg","children":"Slow load time"}],["$","p",null,{"className":"mt-2 leading-relaxed text-fg-muted","children":"A 2017 Google/SOASTA study found that 53% of mobile users abandoned pages taking longer than 3 seconds to load. That figure is nearly a decade old - mobile-first consumption patterns have made patience shorter since. Portent's 2022 analysis of over 100 million page views across 20 B2B and B2C sites found that pages loading in 1 second convert at roughly 3x the rate of pages loading in 5 seconds. A visitor who abandons during load is recorded as a bounce before they have seen your headline."}]]}]
12:["$","div","3",{"className":"rounded border border-accent/20 bg-accent/5 p-6","children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wide text-accent mb-1","children":["Cause ","3"]}],["$","h3",null,{"className":"text-lg font-bold text-fg","children":"Wrong audience"}],["$","p",null,{"className":"mt-2 leading-relaxed text-fg-muted","children":"Broad keyword targeting, irrelevant search terms, or clickbait ad creative brings visitors who were never going to convert. When this is the cause, the fix is not the page - it is the targeting. Segment your analytics by traffic source to confirm. If Google Ads bounces at 40% and a broad awareness campaign bounces at 85%, those are two separate problems requiring two separate fixes."}]]}]
13:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Segment first, fix second"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"The fastest way to identify which cause is active is to segment your analytics before touching the page. Each segment points to a different fix."}],["$","ul",null,{"className":"mt-5 space-y-4","children":[["$","li","By source",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg","children":"By source"}],["$","p",null,{"className":"mt-1 leading-relaxed text-fg-muted","children":"Google Ads vs Meta Ads vs Organic vs Email. If one source bounces at 30% and another at 85%, the problem is source-specific - a targeting or message-match issue on the high-bounce channel, not a page-wide layout problem."}]]}],["$","li","By device",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg","children":"By device"}],["$","p",null,{"className":"mt-1 leading-relaxed text-fg-muted","children":"If mobile bounce is more than 15 percentage points above desktop, your mobile layout is the primary cause - not the ad, not the audience. Check whether headline and CTA are visible without scrolling at 390px."}]]}],["$","li","By traffic temperature",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg","children":"By traffic temperature"}],["$","p",null,{"className":"mt-1 leading-relaxed text-fg-muted","children":"Cold traffic (first-visit paid) bounces more than warm traffic (retargeting, email) by design. Do not compare their bounce rates directly. If cold traffic is at 65% and warm at 30%, that gap is normal. If cold traffic is at 88%, something structural is broken."}]]}],["$","li","By time on page",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg","children":"By time on page"}],["$","p",null,{"className":"mt-1 leading-relaxed text-fg-muted","children":"If average time-on-page for bouncers is under 5 seconds, the cause is load time or an immediate message mismatch. If it is 15–30 seconds, the visitor read the page but was not convinced - the cause is proof or CTA failure, not the above-fold section."}]]}]]}]]}]
14:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Fix sequence: cause determines order"}],["$","ol",null,{"className":"space-y-4","children":[["$","li","0",{"className":"flex gap-4 rounded-xl border border-border bg-bg-muted/10 p-5","children":[["$","span",null,{"className":"shrink-0 font-bold text-accent","children":[1,"."]}],["$","div",null,{"children":[["$","p",null,{"className":"font-semibold text-fg","children":"Match the headline to the ad"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-fg-muted","children":"If the ad says \"Fix your landing page,\" the H1 should say \"Fix your landing page\" - not \"Welcome to Our Platform.\" Copy the specific noun phrase from your highest-traffic ad into the headline. Test before redesigning anything else."}]]}]]}],["$","li","1",{"className":"flex gap-4 rounded-xl border border-border bg-bg-muted/10 p-5","children":[["$","span",null,{"className":"shrink-0 font-bold text-accent","children":[2,"."]}],["$","div",null,{"children":[["$","p",null,{"className":"font-semibold text-fg","children":"Cut load time to under 3 seconds on mobile"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-fg-muted","children":"Compress images (WebP, 80% quality), add lazy loading to below-fold content, remove unused third-party scripts. Check LCP with Google PageSpeed Insights: free, takes under two minutes. If LCP is above 4 seconds, load time is the primary bounce cause regardless of what the headline says."}]]}]]}],["$","li","2",{"className":"flex gap-4 rounded-xl border border-border bg-bg-muted/10 p-5","children":[["$","span",null,{"className":"shrink-0 font-bold text-accent","children":[3,"."]}],["$","div",null,{"children":[["$","p",null,{"className":"font-semibold text-fg","children":"Put the CTA above the fold on mobile"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-fg-muted","children":"Open the page on a real phone at 390px. If the CTA is not visible without scrolling, reposition it. The headline and CTA should both be visible in the first viewport for cold paid traffic."}]]}]]}],["$","li","3",{"className":"flex gap-4 rounded-xl border border-border bg-bg-muted/10 p-5","children":[["$","span",null,{"className":"shrink-0 font-bold text-accent","children":[4,"."]}],["$","div",null,{"children":[["$","p",null,{"className":"font-semibold text-fg","children":"Tighten targeting before scaling"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-fg-muted","children":"If segmentation shows that specific ad sets or keyword groups are driving the high-bounce traffic, pause those and reallocate budget to the lower-bounce sources. Do not fix a targeting problem by redesigning the page."}]]}]]}]]}]]}]
