1a:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Why placement changes the threshold"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"\"Frequency above 5\" is not a single universal ceiling - it moves with where the ad shows up. Feed placements accumulate frequency slowly, since each impression competes with organic content for attention, so fatigue tends to show later. Stories and Reels placements are consumed faster and repeat sooner in a single session, so the same numeric frequency represents more real exposure to the same eyes."}],["$","ul",null,{"className":"mt-4 space-y-2 text-fg-muted","children":[["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":[["$","strong",null,{"className":"text-fg","children":"Feed:"}]," CTR erosion usually starts to show past a frequency of 6-7."]}]]}],["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":[["$","strong",null,{"className":"text-fg","children":"Stories/Reels:"}]," The same erosion often shows up by a frequency of 3-4, because the format is skippable in under a second."]}]]}],["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":[["$","strong",null,{"className":"text-fg","children":"Retargeting audiences:"}]," Frequency climbs fastest here because the pool is small - check this segment separately from cold prospecting."]}]]}]]}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"Break your frequency report out by placement before deciding the ad is fatigued. A blended frequency of 4 can hide a Stories segment already past its real ceiling."}]]}]
