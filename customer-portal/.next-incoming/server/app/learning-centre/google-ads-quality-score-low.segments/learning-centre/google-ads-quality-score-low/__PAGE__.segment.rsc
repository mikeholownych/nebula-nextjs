7:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Read the component breakdown, not just the 1-10 number"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"The single Quality Score number is a diagnostic summary, not the diagnosis itself. Google shows each of the three components rated \"Below average,\" \"Average,\" or \"Above average\" when you hover the score in the keyword view. That breakdown tells you which repair to make first:"}],["$","ul",null,{"className":"mt-4 space-y-2 text-fg-muted","children":[["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":[["$","strong",null,{"className":"text-fg","children":"Landing page experience: Below average, others fine."}]," This isolates the leak to the page - relevance and CTR are already working. Fix the page before touching ad copy."]}]]}],["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":[["$","strong",null,{"className":"text-fg","children":"All three below average."}]," This usually means the keyword itself is mismatched to the offer, not that any single element is broken - see the keyword-fit check below before spending time on page copy."]}]]}],["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":[["$","strong",null,{"className":"text-fg","children":"Expected CTR: Below average, landing page: Average or above."}]," The page is not the leak here - the ad copy or extensions are underselling a page that already converts. Do not change the page based on this pattern."]}]]}]]}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"Fixing a page when the landing page experience component is already \"Average\" or better wastes the repair - re-check the component breakdown after any change to confirm which lever actually moved."}]]}]
8:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"When to give up on the keyword"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"Not every keyword deserves to be saved. Some Quality Score problems are symptoms of a deeper mismatch: the keyword does not align with what you actually offer."}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"Signs it is time to pause or negative-match the keyword:"}],["$","ul",null,{"className":"mt-4 space-y-2 text-fg-muted","children":[["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":[["$","strong",null,{"className":"text-fg","children":"Quality Score below 3 for 30+ days"}]," despite headline and content fixes"]}]]}],["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":[["$","strong",null,{"className":"text-fg","children":"Consistently high bounce rate"}]," (over 70%) from that keyword's traffic"]}]]}],["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":[["$","strong",null,{"className":"text-fg","children":"Sales or leads do not match search intent"}],"-e.g., searchers want information, you offer a service"]}]]}],["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":[["$","strong",null,{"className":"text-fg","children":"The page converts for other keywords"}]," but not this one"]}]]}]]}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"In th