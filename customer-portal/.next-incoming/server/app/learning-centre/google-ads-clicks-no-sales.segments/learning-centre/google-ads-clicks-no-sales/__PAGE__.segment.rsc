11:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"5 page-side causes of zero conversions from paid search"}],["$","div",null,{"className":"space-y-5","children":[["$","div","1",{"className":"rounded-xl border border-border p-6","children":[["$","p",null,{"className":"text-xs font-bold uppercase tracking-wide text-accent mb-1","children":["Cause ","1"]}],["$","h3",null,{"className":"text-lg font-bold text-fg","children":"Headline does not match the search intent"}],["$","p",null,{"className":"mt-2 leading-relaxed text-fg-muted","children":"The visitor typed a specific phrase, clicked an ad that echoed it, and landed on a page that says something different. The mismatch registers in under a second. A visitor searching \"fix landing page conversion rate\" and landing on \"Transform Your Marketing With AI\" has no confirmation they are in the right place. They leave. The fix is to use the exact noun phrase from your highest-traffic ad groups in the page H1."}]]}],["$","div","2",{"className":"rounded-xl border border-border p-6","children":[["$","p",null,{"className":"text-xs font-bold uppercase tracking-wide text-accent mb-1","children":["Cause ","2"]}],["$","h3",null,{"className":"text-lg font-bold text-fg","children":"No proof above the fold"}],["$","p",null,{"className":"mt-2 leading-relaxed text-fg-muted","children":"Cold paid search traffic has no prior relationship with your brand. The page is asking for trust it has not yet earned. If the first viewport contains only a headline and a CTA with no proof signal - no customer result, no recognisable logo, no specific outcome - a significant portion of visitors will not take action. One specific, attributed proof element above the fold changes the trust calculus for a visitor who has never heard of you."}]]}],["$","div","3",{"className":"rounded-xl border border-border p-6","children":[["$","p",null,{"className":"text-xs font-bold uppercase tracking-wide text-accent mb-1","children":["Cause ","3"]}],["$","h3",null,{"className":"text-lg font-bold text-fg","children":"Slow mobile load"}],["$","p",null,{"className":"mt-2 leading-relaxed text-fg-muted","children":"A visitor who abandons while the page is loading is recorded as a bounce before they have seen your headline. Portent's 2022 analysis of over 100 million page views found that B2B lead-gen pages loading in 1 second convert at roughly 3x the rate of pages loading in 5 seconds. Check LCP with Google PageSpeed Insights on the mobile preset - not desktop. If LCP is above 4 seconds, treat load performance as a high-priority hypothesis and test it against other campaign and page signals."}]]}],["$","div","4",{"className":"rounded-xl border border-border p-6","children":[["$","p",null,{"className":"text-xs font-bold uppercase tracking-wide text-accent mb-1","children":["Cause ","4"]}],["$","h3",null,{"className":"text-lg font-bold text-fg","children":"Traffic sent to the homepage"}],["$","p",null,{"className":"mt-2 leading-relaxed text-fg-muted","children":"A homepage is built to route multiple audience types across multiple offers. A paid search visitor arrived because of one specific promise. A homepage can dilute that promise by presenting navigation, multiple services, and no single conversion path. Compare it with a dedicated page under equivalent traffic conditions rather than assuming page type caused the result."}]]}],["$","div","5",{"className":"rounded-xl border border-border p-6","children":[["$","p",null,{"className":"text-xs font-bold uppercase tracking-wide text-accent mb-1","children":["Cause ","5"]}],"$L20","$L21"]}]]}]]}]
12:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Diagnosing the specific cause from analytics"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"Do not guess which cause is active - read the analytics patterns:"}],["$","ul",null,{"className":"mt-5 space-y-4","children":[["$","li","High CTR, high bounce, under 5s on page",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg text-sm","children":"High CTR, high bounce, under 5s on page"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-fg-muted","children":"Load time or immediate message mismatch. The visitor decided in under 5 seconds. Check mobile LCP first, then headline alignment with ad keywords."}]]}],["$","li","High CTR, high bounce, 15–30s on page",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg text-sm","children":"High CTR, high bounce, 15–30s on page"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-fg-muted","children":"Visitor read the page but was not convinced. Message match likely fine. The issue is proof, CTA clarity, or offer specificity."}]]}],["$","li","Low CTR (under 2-3%) on search",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg text-sm","children":"Low CTR (under 2-3%) on search"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-fg-muted","children":"Prioritise an ad-copy or keyword-match hypothesis, then compare it against page and traffic-quality evidence before changing the landing page."}]]}],["$","li","Mobile bounce 20+ points above desktop",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg text-sm","children":"Mobile bounce 20+ points above desktop"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-fg-muted","children":"Mobile layout or mobile load time. Same page, different rendering. Check 390px viewport and mobile LCP specifically."}]]}],["$","li","Zero form starts (not just zero submits)",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg text-sm","children":"Zero form starts (not just zero submits)"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-fg-muted","children":"Visitors are not engaging with the form at all. The issue is above-fold - either they are bouncing before reaching the form, or the form is positioned below where attention ends."}]]}]]}]]}]
