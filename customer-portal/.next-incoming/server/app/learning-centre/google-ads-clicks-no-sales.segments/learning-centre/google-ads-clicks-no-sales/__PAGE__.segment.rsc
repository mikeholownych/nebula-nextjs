ed Page Conditions on Your Landing Page | Nebula Components"}],["$","meta","16",{"name":"twitter:description","content":"Free landing page audit that finds failed page conditions on public HTML. Evidence-backed, no signup, results in under 2 minutes."}],["$","meta","17",{"name":"twitter:image","content":"https://nebulacomponents.com/brand/v2/og-default.png"}],["$","link","18",{"rel":"shortcut icon","href":"/favicon.svg"}],["$","link","19",{"rel":"icon","href":"/favicon.svg","type":"image/svg+xml"}],["$","link","20",{"rel":"icon","href":"/brand/v2/favicon-32.png","sizes":"32x32","type":"image/png"}],["$","link","21",{"rel":"icon","href":"/brand/v2/favicon-16.png","sizes":"16x16","type":"image/png"}],["$","link","22",{"rel":"apple-touch-icon","href":"/brand/v2/apple-touch-icon.png"}],["$","$L1c","23",{}]]}]}]}],["$","meta",null,{"name":"next-size-adjust","content":""}]]}]
