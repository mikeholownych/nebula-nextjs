4:["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":[["$","strong",null,{"className":"font-semibold","children":"Malware or unwanted software:"}]," Even if your site is clean, third-party scripts, expired SSL certificates, or compromised plugins can trigger immediate disapproval."]}]]}]
5:["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"The issue is that these violations are often invisible to the advertiser. The page loads. It looks fine. But Google's automated crawlers detect the underlying policy breach."}]
6:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Why the ad can keep spending after disapproval"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"The specific mechanic advertisers miss: disapproval and delivery are not always the same switch. A few paths let spend continue after a violation is detected:"}],["$","ul",null,{"className":"mt-4 space-y-2 text-fg-muted","children":[["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":[["$","strong",null,{"className":"font-semibold","children":"Delayed re-crawl:"}]," Google's policy crawler does not re-check a live landing page on every impression. A page that passed review, then broke (expired cert, a redirect added later, a plugin update), can keep serving and accruing cost until the next crawl catches the change."]}]]}],["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":[["$","strong",null,{"className":"font-semibold","children":"Ad group vs. ad-level scope:"}]," A violation flagged on one ad in a group does not always immediately pause sibling ads pointing to the same broken page - they can keep spending until each is individually reviewed."]}]]}],["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":[["$","strong",null,{"className":"font-semibold","children":"\"Limited\" vs. \"Disapproved\" status:"}]," A \"Limited\" policy status still serves in some geos or contexts while under review - it is easy to read this as fully paused when it is not."]}]]}]]}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"Check the Recommendations and Policy Manager sections of the account directly rather than assuming a disapproved label always means zero delivery - the gap between the two is where budget quietly leaks."}]]}]
7:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Account-level fallout"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"A single landing page violation can cascade beyond the ad itself:"}],["$","ul",null,{"className":"mt-4 space-y-2 text-fg-muted","children":[["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":[["$","strong",null,{"className":"font-semibold","children":"Ad disapprovals compound:"}]," Multiple ads pointing to the same violating page all get flagged simultaneously."]}]]}],["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":[["$","strong",null,{"className":"font-semibold","children":"Account standing degrades:"}]," Repeated landing page violations lower your account's policy compliance score, leading to stricter scrutiny on future ads."]}]]}],["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":[["$","strong",null,{"className":"font-semibold","children":"Budget drain during review:"}]," Some disapproved ads continue accruing costs while under review or appeal-especially if the violation is borderline and being manually evaluated."]}]]}],["$","li",null,{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"}],["$","span",null,{"children":[["$","strong",null,{"className":"font-semibold","children":"Recovery takes time:"}]," Fixing the page doesn't instantly restore the ad. Each disapproved ad must be resubmitted for review, adding days to campaign timelines."]}]]}]]}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"Preventing the violation before it triggers review is reliably effective - and far less disruptive than recovering after suspension."}]]}]
