2b:["$","section",null,{"className":"mt-14","children":[["$","h2",null,{"className":"text-2xl font-bold text-fg","children":"3. Value-First Page Structure"}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"Don't remove the demo CTA-move it. The page earns the ask by building evidence before it arrives."}],["$","ol",null,{"className":"mt-6 space-y-3","children":[["$","li","0",{"className":"flex items-baseline gap-3 text-fg-muted","children":[["$","span",null,{"className":"shrink-0 text-xs font-bold text-accent","children":1}],["$","span",null,{"className":"text-sm leading-relaxed","children":"Hero - clear value prop + one trust signal (logo, stat, G2 badge)"}]]}],["$","li","1",{"className":"flex items-baseline gap-3 text-fg-muted","children":[["$","span",null,{"className":"shrink-0 text-xs font-bold text-accent","children":2}],["$","span",null,{"className":"text-sm leading-relaxed","children":"Problem statement - show you understand the specific pain"}]]}],["$","li","2",{"className":"flex items-baseline gap-3 text-fg-muted","children":[["$","span",null,{"className":"shrink-0 text-xs font-bold text-accent","children":3}],["$","span",null,{"className":"text-sm leading-relaxed","children":"Solution overview - how you solve it differently"}]]}],["$","li","3",{"className":"flex items-baseline gap-3 text-fg-muted","children":[["$","span",null,{"className":"shrink-0 text-xs font-bold text-accent","children":4}],["$","span",null,{"className":"text-sm leading-relaxed","children":"Case studies - real outcomes from similar companies"}]]}],["$","li","4",{"className":"flex items-baseline gap-3 text-fg-muted","children":[["$","span",null,{"className":"shrink-0 text-xs font-bold text-accent","children":5}],["$","span",null,{"className":"text-sm leading-relaxed","children":"Interactive value - ROI calc or self-assessment"}]]}],["$","li","5",{"className":"flex items-baseline gap-3 text-fg-muted","children":[["$","span",null,{"className":"shrink-0 text-xs f