e:["$","$1","h",{"children":[null,["$","$L1a",null,{"children":[["$","meta","0",{"charSet":"utf-8"}],["$","meta","1",{"name":"viewport","content":"width=device-width, initial-scale=1, viewport-fit=cover"}],["$","meta","2",{"name":"theme-color","content":"#080909"}],["$","meta","3",{"name":"color-scheme","content":"dark"}]]}],["$","div",null,{"hidden":true,"children":["$","$L1b",null,{"children":["$","$18",null,{"name":"Next.Metadata","children":[["$","title","0",{"children":"Ghost Variant: When A/B Test Winners Are False Positives"}],["$","meta","1",{"name":"description","content":"A ghost variant is when your control quietly breaks mid-test - a missing pixel, a truncated H1, a 404ing social proof block - and the \"winning\" variant wins by default. Here is how to detect it before you ship."}],["$","link","2",{"rel":"manifest","href":"/manifest.webmanifest"}],["$","link","3",{"rel":"canonical","href":"https://nebulacomponents.com/learning-centre/ghost-variant-ab-test"}],["$","meta","4",{"property":"og:title","content":"Find Failed Page Conditions on Your Landing Page | Nebula Components"}],["$","meta","5",{"property":"og:description","content":"Free landing page audit that finds failed page conditions on public HTML. Evidence-backed, no signup, results in under 2 minutes."}],["$","meta","6",{"property":"og:site_name","content":"Nebula Components"}],["$","meta","7",{"property":"og:locale","content":"en_US"}],["$","meta","8",{"property":"og:image","content":"https://nebulacomponents.com/brand/v2/og-default.png"}],["$","meta","9",{"property":"og:image:width","content":"1200"}],["$","meta","10",{"property":"og:image:height","content":"630"}],["$","meta","11",{"property":"og:image:alt","content":"Nebula Components - inspect failed page conditions before spending more on ads"}],["$","meta","12",{"property":"og:type","content":"website"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:creator","content":"@NebulaC