1a:["$","main",null,{"id":"main-content","className":"min-h-screen bg-bg pt-24","children":["$","div",null,{"className":"mx-auto max-w-3xl px-6 py-14","children":[["$","$L21",null,{"href":"/learning-centre","className":"text-sm font-semibold text-accent hover:text-fg transition-colors","children":"Back to Learning Centre"}],["$","div",null,{"className":"mt-8 rounded-md border border-border bg-bg-panel p-8 md:p-10","children":[["$","p",null,{"className":"mb-4 text-xs font-semibold uppercase tracking-[0.12em] text-accent","children":"Mobile Conversion · Paid Traffic"}],["$","h1",null,{"className":"text-3xl font-bold tracking-tight text-fg md:text-5xl","children":"Fix Mobile Landing Page Leaks to Boost Paid Traffic ROAS"}],["$","p",null,{"className":"mt-5 max-w-2xl text-lg leading-relaxed text-fg-muted","children":"The majority of paid social traffic arrives on mobile. A page that converts well on desktop can leak most of that traffic through five structural failures that are invisible on a laptop screen - and immediately obvious on a phone. The audit takes five minutes on your own device."}],["$","div",null,{"className":"mt-6 flex flex-col sm:flex-row items-stretch sm:items-center gap-3","children":[["$","$L21",null,{"href":"/audit?utm_source=learning-centre-mobile-landing-page-leaks&utm_medium=hero-cta","className":"inline-flex min-h-[44px] items-center justify-center rounded bg-accent px-6 py-3 text-sm font-semibold text-bg transition-opacity hover:opacity-85","children":"Get your free audit →"}],["$","$L21",null,{"href":"/repair-sprint","className":"inline-flex min-h-[44px] items-center justify-center rounded border border-border px-5 py-3 text-sm font-medium text-fg-muted transition-colors hover:border-fg-muted hover:text-fg","children":"Explore $97 Repair Sprint"}]]}]]}],["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Why desktop conversion rates mislead you about mobile"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"If you look at overall conversion data without segmenting by device, a healthy desktop rate can mask a broken mobile experience. An overall rate of 3% might be a 6% desktop rate and a 1% mobile rate - but the blended number hides the structural failure that is affecting the majority of your paid social traffic."}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"Check your analytics segmented by device. If mobile conversion is 50% or more below desktop on the same page with meaningful volume, you have a mobile structural problem - not an audience quality problem. The audience arriving from mobile paid social is not inherently lower intent; they are encountering a different page."}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"The Chrome UX Report consistently shows LCP scores 40–60% worse on mobile than desktop for the same URL. That gap alone means a page that passes Core Web Vitals on desktop frequently fails on mobile - and Google's Quality Score evaluation uses mobile performance for mobile-originated ad traffic."}]]}],["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-6 text-2xl font-bold text-fg","children":"The 5 mobile leaks"}],["$","div",null,{"className":"space-y-6","children":[["$","div","01",{"className":"rounded-xl border border-border p-6","children":[["$","p",null,{"className":"text-xs font-bold uppercase tracking-widest text-accent mb-1","children":["Leak ","01"]}],["$","h3",null,{"className":"text-lg font-bold text-fg","children":"Hero text too small to read without zooming"}],"$L2a","$L2b"]}],"$L2c","$L2d","$L2e","$L2f"]}]]}],"$L30","$L31","$L32","$L33","$L34"]}]}]
