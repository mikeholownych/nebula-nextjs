1f:[["$","title","0",{"children":"Mobile Landing Page Leaks: 5 Structural Friction Points | Nebula"}],["$","meta","1",{"name":"description","content":"The majority of paid social traffic arrives on mobile. These five structural leaks can increase bounce rate on mobile viewports. Diagnose them with a 5-minute inspection."}],["$","link","2",{"rel":"manifest","href":"/manifest.webmanifest","crossOrigin":"$undefined"}],["$","link","3",{"rel":"canonical","href":"https://nebulacomponents.com/learning-centre/mobile-landing-page-leaks"}],["$","meta","4",{"property":"og:title","content":"Find Failed Page Conditions on Your Landing Page | Nebula Components"}],["$","meta","5",{"property":"og:description","content":"Free landing page audit that finds failed page conditions on public HTML. Evidence-backed, no signup, results in under 2 minutes."}],["$","meta","6",{"property":"og:site_name","content":"Nebula Components"}],["$","meta","7",{"property":"og:locale","content":"en_US"}],["$","meta","8",{"property":"og:image","content":"https://nebulacomponents.com/brand/v2/og-default.png"}],["$","meta","9",{"property":"og:image:width","content":"1200"}],["$","meta","10",{"property":"og:image:height","content":"630"}],["$","meta","11",{"property":"og:image:alt","content":"Nebula Components - inspect failed page conditions before spending more on ads"}],["$","meta","12",{"property":"og:type","content":"website"}],["$","meta","13",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","14",{"name":"twitter:creator","content":"@NebulaCRO"}],["$","meta","15",{"name":"twitter:title","content":"Find Failed Page Conditions on Your Landing Page | Nebula Components"}],["$","meta","16",{"name":"twitter:description","content":"Free landing page audit that finds failed page conditions on public HTML. Evidence-backed, no signup, results in under 2 minutes."}],["$","meta","17",{"name":"twitter:image","content":"https://nebulacomponents.com/brand/v2/og-default.png"}],["$","link","18",{"r