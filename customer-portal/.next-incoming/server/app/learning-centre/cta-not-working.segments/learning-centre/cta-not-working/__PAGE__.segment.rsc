0:{"buildId":"7bDX3U26LLul0JhiFybGF","data":[{"rsc":["$","$1","c",{"children":[["$","main",null,{"id":"main-content","className":"min-h-screen bg-bg pt-24","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Fix Broken CTAs to Increase Landing Page Conversion Rates\",\"description\":\"Your CTA fails when it asks for more than the page has earned. Learn the 4 CTA failure modes, the commitment ladder, and the copy formula that converts.\",\"author\":{\"@id\":\"https://nebulacomponents.com/#founder\"},\"datePublished\":\"2026-07-21\",\"dateModified\":\"2026-07-21\",\"publisher\":{\"@id\":\"https://nebulacomponents.com/#organization\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://nebulacomponents.com/learning-centre/cta-not-working\"},\"image\":\"https://nebulacomponents.com/opengraph-image\"}"}}],["$","div",null,{"className":"mx-auto max-w-3xl px-6 py-14","children":[["$","$L2",null,{"href":"/learning-centre","className":"text-sm font-semibold text-accent hover:text-fg transition-colors","children":"← Learning Centre"}],["$","div",null,{"className":"mt-8 rounded-md border border-border bg-bg-panel p-8 md:p-10","children":[["$","p",null,{"className":"mb-4 text-xs font-semibold uppercase tracking-[0.12em] text-accent","children":"Conversion Copy · CTA Optimisation"}],["$","h1",null,{"className":"text-3xl font-bold tracking-tight text-fg md:text-5xl","children":"Fix Broken CTAs to Increase Landing Page Conversion Rates"}],["$","p",null,{"className":"mt-5 max-w-2xl text-lg leading-relaxed text-fg-muted","children":"A broken CTA is almost never a button-colour problem. It's a commitment mismatch - your page asked for more trust than it had built. Here's how to diagnose the exact failure mode and fix it."}],["$","div",null,{"className":"mt-6 flex flex-col sm:flex-row items-stretch sm:items-center gap-3","children":[["$","$L2",null,{"href":"/audit?utm_source=learning-centre-cta-not-working&utm_medium=hero-cta","className":"inline-flex min-h-[44px] items-center justify-center rounded bg-accent px-6 py-3 text-sm font-semibold text-bg transition-opacity hover:opacity-85","children":"Get your free audit →"}],["$","$L2",null,{"href":"/repair-sprint","className":"inline-flex min-h-[44px] items-center justify-center rounded border border-border px-5 py-3 text-sm font-medium text-fg-muted transition-colors hover:border-fg-muted hover:text-fg","children":"Explore $97 Repair Sprint"}]]}]]}],["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Why CTAs Fail: The Commitment Mismatch"}],["$","p",null,{"className":"mb-4 leading-relaxed text-fg-muted","children":"Every CTA is a request. You're asking a stranger - someone who arrived at your page seconds ago - to hand over their email, their time, or their money. Whether they comply depends almost entirely on one thing: whether the page has built enough trust to justify what you're asking."}],["$","p",null,{"className":"mb-4 leading-relaxed text-fg-muted","children":"Most landing pages get this wrong in the same direction. They ask for a demo call before showing a single proof point. They ask for a $297 purchase before the visitor has read one testimonial. They display a 'Buy Now' button near the beginning of the page, before the visitor knows what the product even does. The button itself is fine. The sequence is broken."}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"Commitment mismatch is the root cause behind most CTA failures. Before you change button colours or A/B test copy, you need to audit whether your page has actually earned the ask you're making."}]]}],"$L3","$L4","$L5","$L6","$L7","$L8","$L9"]}]]}],null,"$La"]}],"isPartial":"$@b","staleTime":"$c","varyParams":null},{"rsc":"$Ld","isPartial":"$@e","staleTime":"$c","varyParams":null},{"rsc":"$Lf","isPartial":"$@10","staleTime":"$c","varyParams":"$11"},{"rsc":"$L12","isPartial":"$@13","staleTime":"$c","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@14","rootVaryParams":null,"needsRuntimeRequest":"$@15"}
