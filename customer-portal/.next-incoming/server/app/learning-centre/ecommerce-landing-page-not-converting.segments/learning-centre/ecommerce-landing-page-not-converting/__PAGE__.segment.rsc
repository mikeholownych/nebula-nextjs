12:["$","li","Mobile conversion 50%+ below desktop",{"className":"rounded-xl border border-border p-4","children":[["$","p",null,{"className":"font-semibold text-fg text-sm","children":"Mobile conversion 50%+ below desktop"}],["$","p",null,{"className":"text-xs text-accent font-medium mt-0.5","children":"Cross-cutting mobile failure"}],["$","p",null,{"className":"text-sm leading-relaxed text-fg-muted mt-1","children":"Broken mobile layout, slow LCP on mobile, or CTA not visible above fold on phone"}]]}]
13:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"The 5 ecommerce landing page leaks"}],["$","div",null,{"className":"space-y-6","children":[["$","div","1",{"className":"rounded-xl border border-border p-6","children":[["$","p",null,{"className":"text-xs font-bold uppercase tracking-wide text-accent mb-1","children":["Leak ","1"]}],["$","h3",null,{"className":"text-lg font-bold text-fg","children":"No social proof visible above the add-to-cart CTA"}],["$","p",null,{"className":"mt-3 leading-relaxed text-fg-muted","children":"Research from the Spiegel Research Center (Northwestern University, 2017) found that displaying reviews can increase conversion rate by up to 270% for lower-priced products. For ecommerce, this effect is most pronounced when the review count and star average are visible near the product price - not in a separate reviews section scrolled below."}],["$","div",null,{"className":"mt-4 rounded-lg bg-accent/5 border border-accent/20 p-4","children":[["$","p",null,{"className":"text-xs font-bold uppercase tracking-wide text-accent mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm leading-relaxed text-fg-muted","children":"Surface your review count and star average above the fold, next to the price. If you have fewer than 10 reviews, feature the most specific one (with result detail) as a quote near the CTA. Generic \"Great product!\" reviews provide no signal. Specific \"I've had this for 6 months, the stitching held up after 40 washes\" reviews reduce risk."}]]}]]}],["$","div","2",{"className":"rounded-xl border border-border p-6","children":[["$","p",null,{"className":"text-xs font-bold uppercase tracking-wide text-accent mb-1","children":["Leak ","2"]}],["$","h3",null,{"className":"text-lg font-bold text-fg","children":"Shipping cost hidden until checkout"}],["$","p",null,{"className":"mt-3 leading-relaxed text-fg-muted","children":"Baymard Institute's large-scale research on cart abandonment consistently identifies unexpected costs at checkout - primarily shipping - as the single leading cause of abandonment. Visitors who discover the true total cost at checkout feel deceived. Even when the shipping cost is reasonable, the surprise creates friction that a pre-disclosed cost would not."}],["$","div",null,{"className":"mt-4 rounded-lg bg-accent/5 border border-accent/20 p-4","children":[["$","p",null,{"className":"text-xs font-bold uppercase tracking-wide text-accent mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm leading-relaxed text-fg-muted","children":"Show shipping cost and estimated delivery date on the product page, near the price and add-to-cart button. If shipping is free above a threshold, state it explicitly: \"Free shipping on orders over $X.\" If you offer free shipping, make it the most visible element on the page. Visitors who know the total cost before adding to cart abandon at a meaningfully lower rate."}]]}]]}],["$","div","3",{"className":"rounded-xl border border-border p-6","children":[["$","p",null,{"className":"text-xs font-bold uppercase tracking-wide text-accent mb-1","children":["Leak ","3"]}],["$","h3",null,{"className":"text-lg font-bold text-fg","children":"Mobile add-to-cart not visible above the fold"}],["$","p",null,{"className":"mt-3 leading-relaxed text-fg-muted","children":"The majority of paid social traffic arrives on mobile. On a standard 844px iPhone viewport with a 72px nav, the visible area is approximately 770px. A product image at 400px + product name + star rating + price already consumes most of that. If the add-to-cart button sits below those elements, it is off-screen - requiring a scroll that a significant portion of visitors will not make."}],"$L22"]}],"$L23","$L24"]}]]}]
14:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"How to tell if it is a price problem, not a page problem"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"Price testing is expensive - it takes time to gather sufficient data and carries risk of training visitors to wait for discounts. Run this diagnosis before changing price:"}],["$","div",null,{"className":"mt-5 space-y-4","children":[["$","div","Low add-to-cart rate + no reviews",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg text-sm","children":"Low add-to-cart rate + no reviews"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-fg-muted","children":"Fix proof before testing price. Visitors are not converting because they do not trust the product - not because the price is wrong. A lower price on an untrusted page still fails."}]]}],["$","div","Healthy add-to-cart rate + low purchase rate",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg text-sm","children":"Healthy add-to-cart rate + low purchase rate"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-fg-muted","children":"This is a checkout problem, not a price problem. The visitor valued the product enough to add it. Something at checkout - shipping reveal, form friction, or payment trust - broke the chain."}]]}],["$","div","High add-to-cart rate + low purchase rate + competitor prices meaningfully lower",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg text-sm","children":"High add-to-cart rate + low purchase rate + competitor prices meaningfully lower"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-fg-muted","children":"This is a genuine price signal. The page is working; the offer is not competitive. Test a price adjustment or add value to the bundle before discounting."}]]}],["$","div","Healthy conversion on desktop + poor conversion on mobile",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg text-sm","children":"Healthy conversion on desktop + poor conversion on mobile"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-fg-muted","children":"This is a mobile layout or mobile load time problem. Price is identical across devices. Fix mobile first."}]]}]]}]]}]
15:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"5 quick wins before the next ad spend"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"These changes can be live within an hour on most ecommerce platforms. Each addresses one of the 5 leaks above:"}],["$","ol",null,{"className":"mt-5 space-y-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-fg-muted text-sm","children":[["$","span",null,{"className":"shrink-0 font-bold text-accent","children":[1,"."]}],"Add review count and star average above the fold, next to the product price - not in a separate reviews tab"]}],["$","li","1",{"className":"flex items-start gap-3 text-fg-muted text-sm","children":[["$","span",null,{"className":"shrink-0 font-bold text-accent","children":[2,"."]}],"Add a shipping cost line or \"Free shipping on orders over $X\" badge immediately above or below the add-to-cart button"]}],["$","li","2",{"className":"flex items-start gap-3 text-fg-muted text-sm","children":[["$","span",null,{"className":"shrink-0 font-bold text-accent","children":[3,"."]}],"Open the page on a real phone and confirm the add-to-cart button is visible without scrolling - if not, implement a sticky CTA bar"]}],["$","li","3",{"className":"flex items-start gap-3 text-fg-muted text-sm","children":[["$","span",null,{"className":"shrink-0 font-bold text-accent","children":[4,"."]}],"Run Google PageSpeed Insights mobile and check LCP - if above 4s, compress the hero image to WebP and add fetchpriority=\"high\""]}],["$","li","4",{"className":"flex items-start gap-3 text-fg-muted text-sm","children":[["$","span",null,{"className":"shrink-0 font-bold text-accent","children":[5,"."]}],"Add a one-line return policy statement directly below the add-to-cart button: \"30-day free returns\" neutralises purchase anxiety at the decision point"]}]]}]]}]
16:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-6 text-2xl font-bold text-fg","children":"Frequently asked questions"}],["$","div",null,{"className":"space-y-6","children":[["$","div","0",{"className":"border-b border-border pb-6 last:border-0 last:pb-0","children":[["$","h3",null,{"className":"mb-2 font-semibold text-fg","children":"What is a good conversion rate for an ecommerce landing page?"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"There is no single benchmark - conversion rate varies significantly by traffic source, product category, price point, and whether the visitor is cold or warm. WordStream's 2026 analysis places the all-industries average Google Ads conversion rate at 8.18%, but ecommerce product pages receiving paid social traffic typically convert lower because the audience is colder and the product requires more consideration. A more useful benchmark is your own historical rate by traffic source and device. If paid social traffic to a product page converts at under 1% with significant volume, the page has a structural problem worth diagnosing before adding more budget."}]]}],["$","div","1",{"className":"border-b border-border pb-6 last:border-0 last:pb-0","children":[["$","h3",null,{"className":"mb-2 font-semibold text-fg","children":"Why do ecommerce ads get clicks but no purchases?"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"The most common causes: (1) the landing page does not match the ad promise - the visitor expected a specific product or offer and landed on a generic category or homepage; (2) no social proof is visible before the add-to-cart CTA - no reviews, no star rating, no indication that others have purchased; (3) shipping cost is hidden until checkout, creating a price surprise that causes abandonment; (4) mobile layout is broken - the add-to-cart button is not visible above the fold on a phone, or images are cut off; (5) page load is slow - Portent's 2022 analysis of 100+ million page views found conversion rate drops significantly as page load time increases beyond 1 second. Start with mobile layout and load time - both affect the majority of paid social traffic."}]]}],["$","div","2",{"className":"border-b border-border pb-6 last:border-0 last:pb-0","children":[["$","h3",null,{"className":"mb-2 font-semibold text-fg","children":"How do I reduce ecommerce cart abandonment?"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"Baymard Institute research consistently finds average cart abandonment rates around 70%. The most actionable causes they identify: unexpected costs at checkout (shipping, tax), being forced to create an account, overly complicated checkout process, and security concerns. The three highest-leverage fixes before checkout: (1) show shipping cost and estimated delivery date on the product page - before the visitor adds to cart; (2) display trust badges (payment icons, security seals, guarantee text) near the add-to-cart button; (3) surface your return policy clearly near the price. Visitors who know the total cost, delivery timeline, and return terms before they add to cart abandon at a meaningfully lower rate."}]]}],["$","div","3",{"className":"border-b border-border pb-6 last:border-0 last:pb-0","children":[["$","h3",null,{"className":"mb-2 font-semibold text-fg","children":"Do product page reviews really increase conversion rate?"}],"$L25"]}],"$L26","$L27","$L28","$L29"]}]]}]
17:["$","section",null,{"className":"mt-6 rounded-2xl border border-accent/40 bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Find which leak is on your product page"}],["$","p",null,{"className":"mb-6 leading-relaxed text-fg-muted","children":"The free Nebula audit checks all 9 signals - including proof placement, mobile layout, and load time - against your actual landing page URL. The $97 One-Leak Repair Sprint supplies a tailored change for one high-confidence page-level finding. You or your developer implements it, and the 30-day re-audit verifies the page condition. It does not promise conversion lift."}],["$","div",null,{"className":"flex flex-wrap gap-4","children":[["$","$L10",null,{"href":"/audit?utm_source=learning-centre&utm_medium=organic-content","className":"inline-flex rounded bg-accent px-6 py-3 font-semibold text-bg hover:opacity-85 hover:bg-accent transition-colors","children":"Run the free audit"}],["$","$L10",null,{"href":"/pricing","className":"inline-flex rounded border border-accent px-6 py-3 font-semibold text-accent hover:bg-accent-dim transition-colors","children":"See the One-Leak Repair Sprint"}]]}]]}]
18:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Related leak checks"}],["$","div",null,{"className":"space-y-1","children":[["$","$L10","/learning-centre/mobile-landing-page-leaks",{"href":"/learning-centre/mobile-landing-page-leaks","className":"block border-b border-border py-2.5 text-fg-muted transition-colors last:border-0 hover:text-accent","children":"Mobile Landing Page Leaks That Waste Paid Traffic"}],["$","$L10","/learning-centre/landing-page-not-converting",{"href":"/learning-centre/landing-page-not-converting","className":"block border-b border-border py-2.5 text-fg-muted transition-colors last:border-0 hover:text-accent","children":"Landing Page Not Converting? Diagnose These 5 Leaks First"}],["$","$L10","/learning-centre/google-ads-clicks-no-sales",{"href":"/learning-centre/google-ads-clicks-no-sales","className":"block border-b border-border py-2.5 text-fg-muted transition-colors last:border-0 hover:text-accent","children":"Google Ads Clicks But No Sales: Check The Page"}],["$","$L10","/learning-centre/proof-before-cta",{"href":"/learning-centre/proof-before-cta","className":"block border-b border-border py-2.5 text-fg-muted transition-colors last:border-0 hover:text-accent","children":"Proof Before CTA: The Ordering Rule That Lifts Conversions"}],["$","$L10","/learning-centre/before-you-raise-ad-budget",{"href":"/learning-centre/before-you-raise-ad-budget","className":"block border-b border-border py-2.5 text-fg-muted transition-colors last:border-0 hover:text-accent","children":"Before You Raise Ad Budget: Fix The Leaks First"}]]}]]}]
