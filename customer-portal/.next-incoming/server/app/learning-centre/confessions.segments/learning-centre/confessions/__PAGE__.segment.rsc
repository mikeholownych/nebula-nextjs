3:["$","section","2",{"className":"rounded-md border border-border bg-bg-panel p-8","children":[["$","div",null,{"className":"mb-4 flex flex-wrap items-center gap-3","children":[["$","span",null,{"className":"rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold text-accent","children":"ecommerce"}],["$","span",null,{"className":"rounded-full bg-fg-muted/10 px-3 py-1 text-xs text-fg-muted","children":["$$3,800"," spent"]}],["$","span",null,{"className":"rounded-full bg-fg-muted/10 px-3 py-1 text-xs text-fg-muted","children":"6 weeks"}],["$","span",null,{"className":"rounded-full bg-danger/10 px-3 py-1 text-xs text-danger","children":["blamed: ","Meta's algorithm"]}]]}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":["“","Six weeks of Meta ads. $3,800 gone. I told myself the algorithm was broken, CPMs were up industry-wide, the creative needed refreshing. The audit found the page was loading a 340KB HTML payload - we had a video autoplaying in the background that nobody had removed after a product shoot. The page took 8 seconds to load on 4G. I had been optimising ad creative for a page that nobody could wait for.","”"]}]]}]
4:["$","section","3",{"className":"rounded-md border border-border bg-bg-panel p-8","children":[["$","div",null,{"className":"mb-4 flex flex-wrap items-center gap-3","children":[["$","span",null,{"className":"rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold text-accent","children":"coaching / consulting"}],["$","span",null,{"className":"rounded-full bg-fg-muted/10 px-3 py-1 text-xs text-fg-muted","children":["$$2,100"," spent"]}],["$","span",null,{"className":"rounded-full bg-fg-muted/10 px-3 py-1 text-xs text-fg-muted","children":"9 weeks"}],["$","span",null,{"className":"rounded-full bg-danger/10 px-3 py-1 text-xs text-danger","children":["blamed: ","the audience targeting"]}]]}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":["“","I spent nine weeks A/B testing audiences. $2,100 in Facebook spend. Narrow audiences, broad audiences, lookalikes, retargeting. The audit flagged that my social proof section - three testimonials I had spent two hours writing - wasn't rendering. The images had 404ed after I moved them to a new folder. The testimonials were there in the HTML. Invisible to every visitor for nine weeks.","”"]}]]}]
5:["$","section","4",{"className":"rounded-md border border-border bg-bg-panel p-8","children":[["$","div",null,{"className":"mb-4 flex flex-wrap items-center gap-3","children":[["$","span",null,{"className":"rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold text-accent","children":"B2B SaaS"}],["$","span",null,{"className":"rounded-full bg-fg-muted/10 px-3 py-1 text-xs text-fg-muted","children":["$$4,500"," spent"]}],["$","span",null,{"className":"rounded-full bg-fg-muted/10 px-3 py-1 text-xs text-fg-muted","children":"4 months"}],["$","span",null,{"className":"rounded-full bg-danger/10 px-3 py-1 text-xs text-danger","children":["blamed: ","the sales process"]}]]}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":["“","Four months. $4,500 in LinkedIn ads. I had convinced myself the problem was post-click: the sales process was too slow, leads were going cold, we needed a better CRM sequence. The audit found the meta description was 201 characters - it got truncated in every LinkedIn preview at exactly the wrong word, cutting off before we named the specific problem we solve. Every ad click arrived having read half a sentence that ended with 'for teams who struggle with'.","”"]}]]}]
6:["$","section","5",{"className":"rounded-md border border-border bg-bg-panel p-8","children":[["$","div",null,{"className":"mb-4 flex flex-wrap items-center gap-3","children":[["$","span",null,{"className":"rounded-full bg-accent/10 px-3 py-1 text-xs font-semibold text-accent","children":"ecommerce"}],["$","span",null,{"className":"rounded-full bg-fg-muted/10 px-3 py-1 text-xs text-fg-muted","children":["$$1,900"," spent"]}],["$","span",null,{"className":"rounded-full bg-fg-muted/10 px-3 py-1 text-xs text-fg-muted","children":"7 weeks"}],["$","span",null,{"className":"rounded-full bg-danger/10 px-3 py-1 text-xs text-danger","children":["blamed: ","the product photos"]}]]}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":["“","Seven weeks, $1,900, three different product photographers. The audit found there was no CTA button above the fold on mobile - our designer had hidden it behind a hamburger menu 'to reduce visual clutter'. On desktop it was fine. 70% of our traffic was mobile. The button that was supposed to close the sale was one tap away from invisible.","”"]}]]}]
