2a:["$","div","2",{"className":"rounded border border-accent/20 bg-accent/5 p-6","children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wide text-accent mb-1","children":["Cause ","2"]}],["$","h3",null,{"className":"text-lg font-bold text-fg","children":"Slow load time"}],["$","p",null,{"className":"mt-2 leading-relaxed text-fg-muted","children":"A 2017 Google/SOASTA study found that 53% of mobile users abandoned pages taking longer than 3 seconds to load. That figure is nearly a decade old - mobile-first consumption patterns have made patience shorter since. Portent's 2022 analysis of over 100 million page views across 20 B2B and B2C sites found that pages loading in 1 second convert at roughly 3x the rate of pages loading in 5 seconds. A visitor who abandons during load is recorded as a bounce before they have seen your headline."}]]}]
2b:["$","div","3",{"className":"rounded border border-accent/20 bg-accent/5 p-6","children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wide text-accent mb-1","children":["Cause ","3"]}],["$","h3",null,{"className":"text-lg font-bold text-fg","children":"Wrong audience"}],["$","p",null,{"className":"mt-2 leading-relaxed text-fg-muted","children":"Broad keyword targeting, irrelevant search terms, or clickbait ad creative brings visitors who were never going to convert. When this is the cause, the fix is not the page - it is the targeting. Segment your analytics by traffic source to confirm. If Google Ads bounces at 40% and a broad awareness campaign bounces at 85%, those are two separate problems requiring two separate fixes."}]]}]
2c:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Segment first, fix second"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"The fastest way to identify which cause is active is to segment your analytics before touching the page. Each segment points to a different fix."}],["$","ul",null,{"className":"mt-5 space-y-4","children":[["$","li","By source",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg","children":"By source"}],["$","p",null,{"className":"mt-1 leading-relaxed text-fg-muted","children":"Google Ads vs Meta Ads vs Organic vs Email. If one source bounces at 30% and another at 85%, the problem is source-specific - a targeting or message-match issue on the high-bounce channel, not a page-wide layout problem."}]]}],["$","li","By device",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg","children":"By device"}],["$","p",null,{"className":"mt-1 leading-relaxed text-fg-muted","children":"If mobile bounce is more than 15 percentage points above desktop, your mobile layout is the primary cause - not the ad, not the audience. Check whether headline and CTA are visible without scrolling at 390px."}]]}],["$","li","By traffic temperature",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg","children":"By traffic temperature"}],["$","p",null,{"className":"mt-1 leading-relaxed text-fg-muted","children":"Cold traffic (first-visit paid) bounces more than warm traffic (retargeting, email) by design. Do not compare their bounce rates directly. If cold traffic is at 65% and warm at 30%, that gap is normal. If cold traffic is at 88%, something structural is broken."}]]}],["$","li","By time on page",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg","children":"By time on page"}],["$","p",null,{"className":"mt-1 leading-relaxed text-fg-muted","children":"If average time-on-page for bouncers is under 5 seconds, the cause is load time or an immediate message mismatch. If it is 15–30 seconds, the visitor read the page but was not convinced - the cause is proof or CTA failure, not the above-fold section."}]]}]]}]]}]
2d:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Fix sequence: cause determines order"}],["$","ol",null,{"className":"space-y-4","children":[["$","li","0",{"className":"flex gap-4 rounded-xl border border-border bg-bg-muted/10 p-5","children":[["$","span",null,{"className":"shrink-0 font-bold text-accent","children":[1,"."]}],["$","div",null,{"children":[["$","p",null,{"className":"font-semibold text-fg","children":"Match the headline to the ad"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-fg-muted","children":"If the ad says \"Fix your landing page,\" the H1 should say \"Fix your landing page\" - not \"Welcome to Our Platform.\" Copy the specific noun phrase from your highest-traffic ad into the headline. Test before redesigning anything else."}]]}]]}],["$","li","1",{"className":"flex gap-4 rounded-xl border border-border bg-bg-muted/10 p-5","children":[["$","span",null,{"className":"shrink-0 font-bold text-accent","children":[2,"."]}],["$","div",null,{"children":[["$","p",null,{"className":"font-semibold text-fg","children":"Cut load time to under 3 seconds on mobile"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-fg-muted","children":"Compress images (WebP, 80% quality), add lazy loading to below-fold content, remove unused third-party scripts. Check LCP with Google PageSpeed Insights: free, takes under two minutes. If LCP is above 4 seconds, load time is the primary bounce cause regardless of what the headline says."}]]}]]}],["$","li","2",{"className":"flex gap-4 rounded-xl border border-border bg-bg-muted/10 p-5","children":[["$","span",null,{"className":"shrink-0 font-bold text-accent","children":[3,"."]}],["$","div",null,{"children":[["$","p",null,{"className":"font-semibold text-fg","children":"Put the CTA above the fold on mobile"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-fg-muted","children":"Open the page on a real phone at 390px. If the CTA is not visible without scrolling, reposition it. The headline and CTA should both be visible in the first viewport for cold paid traffic."}]]}]]}],["$","li","3",{"className":"flex gap-4 rounded-xl border border-border bg-bg-muted/10 p-5","children":[["$","span",null,{"className":"shrink-0 font-bold text-accent","children":[4,"."]}],["$","div",null,{"children":[["$","p",null,{"className":"font-semibold text-fg","children":"Tighten targeting before scaling"}],["$","p",null,{"className":"mt-1 text-sm leading-relaxed text-fg-muted","children":"If segmentation shows that specific ad sets or keyword groups are driving the high-bounce traffic, pause those and reallocate budget to the lower-bounce sources. Do not fix a targeting problem by redesigning the page."}]]}]]}]]}]]}]
2e:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-6 text-2xl font-bold text-fg","children":"Frequently asked questions"}],["$","div",null,{"className":"space-y-6","children":[["$","div","0",{"className":"border-b border-border pb-6 last:border-0 last:pb-0","children":[["$","h3",null,{"className":"mb-2 font-semibold text-fg","children":"What is a high bounce rate on a paid traffic landing page?"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"There is no universal threshold because bounce rate varies by traffic type and offer. Cold paid traffic bounces more than warm traffic by design - a visitor who clicked an ad for the first time is less committed than someone returning from a retargeting campaign. As a working diagnostic: if your paid traffic bounce rate is above 70%, the first screen is likely not confirming the ad promise. If it is above 85%, the message-match, load time, or audience-targeting problem is severe enough to fix before any other optimisation."}]]}],["$","div","1",{"className":"border-b border-border pb-6 last:border-0 last:pb-0","children":[["$","h3",null,{"className":"mb-2 font-semibold text-fg","children":"What is the difference between bounce rate and exit rate?"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"Bounce means a visitor landed on your page and left without clicking anything - they arrived, decided the page was not what they expected, and left immediately. Exit means they visited multiple pages and this was their last stop. High exit rate on a landing page is normal if visitors explored and then left. High bounce on a paid traffic landing page is the problem - the first screen failed to hold them."}]]}],["$","div","2",{"className":"border-b border-border pb-6 last:border-0 last:pb-0","children":[["$","h3",null,{"className":"mb-2 font-semibold text-fg","children":"How do I reduce bounce rate on a landing page?"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"Diagnose the cause before changing anything. The three most common paid-traffic bounce causes are: (1) message mismatch - the headline does not echo the ad promise; (2) slow load time - Portent's 2022 analysis of 100M+ page views found B2B pages loading in 1 second convert at roughly 3x the rate of pages loading in 5 seconds; (3) wrong audience - broad keywords or clickbait ads bring visitors who were never going to convert. Segment your analytics by source and device to find which cause is active, then fix that cause specifically."}]]}],["$","div","3",{"className":"border-b border-border pb-6 last:border-0 last:pb-0","children":[["$","h3",null,{"className":"mb-2 font-semibold text-fg","children":"Does load time affect bounce rate?"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"Yes, directly. A 2017 Google/SOASTA study found that 53% of mobile users abandoned pages taking longer than 3 seconds to load - and that figure is from 2017, before the shift to mobile-first consumption patterns. More recent data from Portent's 2022 research shows that B2B pages loading in 1 second have a conversion rate roughly 3x higher than pages loading in 5 seconds. Slow load time is a bounce cause, not a separate problem - a visitor who abandons during load is recorded as a bounce before they have seen your headline."}]]}],["$","div","4",{"className":"border-b border-border pb-6 last:border-0 last:pb-0","children":[["$","h3",null,{"className":"mb-2 font-semibold text-fg","children":"What is mobile bounce rate versus desktop?"}],"$L33"]}],"$L34","$L35"]}]]}]
2f:["$","section",null,{"className":"mt-6 rounded-2xl border border-accent/40 bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Find the cause on your page"}],["$","p",null,{"className":"mb-6 leading-relaxed text-fg-muted","children":"The free Nebula audit checks all 9 signals and identifies which one is producing your bounce. The $97 One-Leak Repair Sprint delivers a tailored kit for one high-confidence page-level finding. You or your developer implements it, and the 30-day re-audit verifies the page condition. It does not promise conversion lift."}],["$","div",null,{"className":"flex flex-wrap gap-4","children":[["$","$L21",null,{"href":"/audit?utm_source=learning-centre&utm_medium=organic-content","className":"inline-flex rounded bg-accent px-6 py-3 font-semibold text-bg hover:opacity-85 hover:bg-accent transition-colors","children":"Run the free audit"}],["$","$L21",null,{"href":"/pricing","className":"inline-flex rounded border border-accent px-6 py-3 font-semibold text-accent hover:bg-accent-dim transition-colors","children":"See the One-Leak Repair Sprint"}]]}]]}]
30:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Related leak checks"}],["$","div",null,{"className":"space-y-1","children":[["$","$L21","/learning-centre/landing-page-not-converting",{"href":"/learning-centre/landing-page-not-converting","className":"block border-b border-border py-2.5 text-fg-muted transition-colors last:border-0 hover:text-accent","children":"Landing Page Not Converting? Diagnose These 5 Leaks First"}],["$","$L21","/learning-centre/message-match-checklist",{"href":"/learning-centre/message-match-checklist","className":"block border-b border-border py-2.5 text-fg-muted transition-colors last:border-0 hover:text-accent","children":"Message Match Checklist For Paid Traffic"}],["$","$L21","/learning-centre/landing-page-load-time-slow",{"href":"/learning-centre/landing-page-load-time-slow","className":"block border-b border-border py-2.5 text-fg-muted transition-colors last:border-0 hover:text-accent","children":"Landing Page Load Time Slow: Signal 4 Diagnosis"}],["$","$L21","/learning-centre/mobile-landing-page-leaks",{"href":"/learning-centre/mobile-landing-page-leaks","className":"block border-b border-border py-2.5 text-fg-muted transition-colors last:border-0 hover:text-accent","children":"Mobile Landing Page Leaks That Waste Paid Traffic"}],["$","$L21","/learning-centre/above-fold-landing-page",{"href":"/learning-centre/above-fold-landing-page","className":"block border-b border-border py-2.5 text-fg-muted transition-colors last:border-0 hover:text-accent","children":"Above The Fold: What Paid Traffic Decides Before Scrolling"}]]}]]}]
33:["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"If your mobile bounce rate is significantly higher than desktop - more than 15 percentage points - the gap is almost always a layout problem, not an audience problem. Mobile visitors need the headline and CTA visible without scrolling, and they need the page to load in under 3 seconds on a mobile connection. Diagnose mobile layout (signal 3) and load time (signal 4) specifically for your mobile segment before concluding that mobile traffic is lower quality."}]
34:["$","div","5",{"className":"border-b border-border pb-6 last:border-0 last:pb-0","children":[["$","h3",null,{"className":"mb-2 font-semibold text-fg","children":"What is the average bounce rate for landing pages across industries?"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"Bounce rates vary significantly by industry and traffic type. B2B landing pages typically see 25-55% bounce rates, while e-commerce typically ranges 20-45%. Paid traffic landing pages commonly see 40-60% as baseline. Your benchmark depends on whether traffic is cold (higher bounce expected) or warm (lower bounce expected). Compare against pages receiving similar traffic sources rather than broad industry averages."}]]}]
35:["$","div","6",{"className":"border-b border-border pb-6 last:border-0 last:pb-0","children":[["$","h3",null,{"className":"mb-2 font-semibold text-fg","children":"How does bounce rate differ by traffic source?"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"Organic search traffic typically bounces 40-60% on landing pages. Paid ads (Google Ads, social) commonly see 50-70% bounce rates due to colder audiences. Direct traffic and email tend to bounce 20-40%. Referral traffic bounces 30-50%. These differences reflect visitor intent-organic searchers found you; ad clickers were interrupted. Judge each source against its own baseline, not against overall site averages."}]]}]
