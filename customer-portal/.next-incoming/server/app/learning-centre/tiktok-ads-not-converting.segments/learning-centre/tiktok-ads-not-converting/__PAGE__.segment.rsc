3:["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"The diagnostic question here is: does your landing page feel like a natural extension of the ad, or a jarring gear-change? The visual register, the language register, and the emotional temperature all need to match. A raw UGC ad landing on a glossy brand page is a mismatch the user feels immediately, even if they can't name it."}]
4:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Mobile Speed Is the First Filter"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"TikTok is 100% mobile. Your TikTok traffic lands on a phone, on a cellular connection, often in the middle of a session. If your page doesn't render meaningfully in under 2.5 seconds, a significant portion of those clicks bounce before the page is usable - and you'll never know they were there."}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"Run your landing page URL through Google PageSpeed Insights on mobile. If your LCP (Largest Contentful Paint) is above 3 seconds, that's a conversion leak disguised as a targeting problem. Common causes: uncompressed hero images, unused JavaScript blocking render, third-party scripts loading synchronously, and fonts that delay text display."}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"The fix is not to build a separate TikTok landing page. The fix is to make your landing page fast enough to not punish mobile users - which is the entire TikTok audience."}]]}]
5:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Social Proof That Actually Works for TikTok Traffic"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"TikTok users have calibrated BS detectors for polished testimonials. A headshot photo with a 5-star rating and three sentences in a grid layout reads as staged - because it usually is. TikTok traffic responds to social proof that looks and feels like the platform they just came from."}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"What converts for this traffic source:"}],["$","ul",null,{"className":"mt-3 space-y-2 text-fg-muted","children":[["$","li",null,{"className":"flex gap-2","children":[["$","span",null,{"className":"text-accent font-bold shrink-0","children":"-"}],["$","span",null,{"children":"Short video testimonials embedded directly on the page (not linked, embedded)"}]]}],["$","li",null,{"className":"flex gap-2","children":[["$","span",null,{"className":"text-accent font-bold shrink-0","children":"-"}],["$","span",null,{"children":"Screenshots of real DMs, texts, or comments - unpolished, unformatted"}]]}],["$","li",null,{"className":"flex gap-2","children":[["$","span",null,{"className":"text-accent font-bold shrink-0","children":"-"}],["$","span",null,{"children":"Specific numbers with context: \"83 orders in 6 days\" beats \"great results\""}]]}],["$","li",null,{"className":"flex gap-2","children":[["$","span",null,{"className":"text-accent font-bold shrink-0","children":"-"}],["$","span",null,{"children":"Proof that mirrors the exact claim made in the ad that brought them there"}]]}]]}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"If the ad promised a specific outcome, the first piece of social proof on your page should validate that specific outcome - not a generic brand story."}]]}]
6:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"The Trust Gap for Unknown Brands"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"TikTok advertising is one of the few channels where genuinely unknown brands can interrupt a scrolling session and earn attention. But that means your landing page is often the first time a user encounters your brand at any depth. They have no prior brand equity to draw on."}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"The trust gap is real and the page has to close it fast. Diagnose yours by checking:"}],["$","ul",null,{"className":"mt-3 space-y-2 text-fg-muted","children":[["$","li",null,{"className":"flex gap-2","children":[["$","span",null,{"className":"text-accent font-bold shrink-0","children":"-"}],["$","span",null,{"children":"Is there a money-back guarantee or risk reversal visible above the fold?"}]]}],["$","li",null,{"className":"flex gap-2","children":[["$","span",null,{"className":"text-accent font-bold shrink-0","children":"-"}],["$","span",null,{"children":"Does the page show who is behind the brand - a real person, not just a logo?"}]]}],["$","li",null,{"className":"flex gap-2","children":[["$","span",null,{"className":"text-accent font-bold shrink-0","children":"-"}],["$","span",null,{"children":"Are there any third-party trust signals: press mentions, platform badges, payment logos?"}]]}],["$","li",null,{"className":"flex gap-2","children":[["$","span",null,{"className":"text-accent font-bold shrink-0","children":"-"}],["$","span",null,{"children":"Does the checkout or CTA feel secure, or does it look like a rushed Shopify default?"}]]}]]}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"For TikTok traffic specifically, the risk reversal is often the single highest-leverage addition you can make to a page. A genuine, clearly-worded guarantee eliminates the primary objection for impulse-adjacent buyers who don't have existing trust in your brand."}]]}]
7:["$","section",null,{"className":"mt-6 rounded-2xl border border-accent/40 bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Find the leak on your page"}],["$","p",null,{"className":"mb-6 leading-relaxed text-fg-muted","children":"Run the free Nebula audit to see exactly where your page breaks the chain from click to conversion."}],["$","div",null,{"className":"flex flex-wrap gap-4","children":[["$","$L2",null,{"href":"/audit?utm_source=learning-centre&utm_medium=organic-content","className":"inline-flex rounded bg-accent px-6 py-3 font-semibold text-bg hover:opacity-85 hover:bg-accent transition-colors","children":"Run the free audit"}],["$","$L2",null,{"href":"/learning-centre","className":"inline-flex rounded border border-accent px-6 py-3 font-semibold text-accent hover:bg-accent-dim transition-colors","children":"Browse all leaks"}]]}]]}]
