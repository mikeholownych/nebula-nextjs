0:{"buildId":"-cWzmSOyU1muirH5dfsk2","data":[{"rsc":["$","$1","c",{"children":[["$","main",null,{"id":"main-content","className":"min-h-screen bg-bg text-fg pt-24","children":[["$","$L2",null,{}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Person\",\"@id\":\"https://nebulacomponents.com/#founder\",\"name\":\"Mike Holownych\",\"jobTitle\":\"Founder\",\"url\":\"https://nebulacomponents.com/about/team\",\"description\":\"Founder of Nebula Components. Identified the same seven conversion failure patterns recurring across landing page after landing page - the basis for the 9-point diagnostic framework used in every Nebula audit.\",\"knowsAbout\":[\"Landing page conversion optimization\",\"Message-match diagnosis\",\"Paid traffic (Google Ads, Meta Ads, LinkedIn Ads)\",\"Core Web Vitals\"],\"sameAs\":[\"https://www.linkedin.com/in/mikeholownych\",\"https://github.com/mikeholownych\"],\"worksFor\":{\"@id\":\"https://nebulacomponents.com/#organization\"}}"}}],["$","div",null,{"className":"mx-auto max-w-3xl px-6 py-16","children":[["$","div",null,{"className":"flex flex-col sm:flex-row gap-8 items-start mb-8","children":[["$","img",null,{"src":"/mike-holownych-founder.jpg","alt":"Mike Holownych, Founder of Nebula Components","width":140,"height":210,"className":"rounded-xl object-cover shrink-0 border border-border"}],["$","div",null,{"children":[["$","h1",null,{"className":"heading-1 text-fg","children":"Meet the Team Building Proven Conversion Diagnostics"}],["$","p",null,{"className":"mb-4 font-medium text-accent","children":"Founder, Nebula Components"}]]}]]}],["$","p",null,{"className":"mb-4 text-lg leading-relaxed text-fg-muted","children":"Before founding Nebula Components, I worked with founders running paid traffic whose landing pages weren't converting. The same failures showed up page after page - message-match gaps, missing trust signals, mobile friction, slow load times, unclear CTAs. In the cases I was working on, these were structural issues on the page itself - and they could all be diagnosed from the HTML."}],["$","p",null,{"className":"mb-4 text-lg leading-relaxed text-fg-muted","children":"What I kept seeing: founders spending thousands on traffic to pages with a broken headline, a hidden CTA, and no proof above the fold - then changing the ad without checking the page first. In my experience, the page is often worth investigating before the ad. The fix is usually specific and verifiable. I built Nebula to surface it without a consulting engagement."}],["$","p",null,{"className":"mb-8 text-lg leading-relaxed text-fg-muted","children":"That pattern is what the 9-point diagnostic framework is built from - the same checks that run on every free audit and the paid One-Leak Repair Sprint."}],["$","div",null,{"className":"mb-8 flex flex-wrap gap-4 text-sm","children":[["$","a",null,{"href":"https://www.linkedin.com/in/mikeholownych","target":"_blank","rel":"noopener noreferrer","className":"rounded-lg border border-border px-4 py-2 font-semibold text-fg-muted transition-colors hover:border-accent hover:text-accent","children":"LinkedIn ↗"}],["$","a",null,{"href":"https://github.com/mikeholownych","target":"_blank","rel":"noopener noreferrer","className":"rounded-lg border border-border px-4 py-2 font-semibold text-fg-muted transition-colors hover:border-accent hover:text-accent","children":"GitHub ↗"}]]}],["$","p",null,{"className":"mb-8 text-fg-muted","children":"Nebula Components publishes evidence-backed landing-page conversion guidance and runs automated audit scoring across the same 9 conversion signals."}],["$","span",null,{"className":"text-accent","children":["mike","@","nebulacomponents.com"]}],"$L3"]}]]}],["$L4"],"$L5"]}],"isPartial":"$@6","staleTime":"$7","varyParams":null},{"rsc":"$L8","isPartial":"$@9","staleTime":"$7","varyParams":null},{"rsc":"$La","isPartial":"$@b","staleTime":"$7","varyParams":"$c"},{"rsc":"$Ld","isPa