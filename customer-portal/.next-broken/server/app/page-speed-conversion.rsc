17:["$","main",null,{"id":"main-content","className":"min-h-screen bg-bg pt-24 pb-16","children":["$","article",null,{"className":"mx-auto max-w-4xl px-6","children":[["$","header",null,{"className":"mb-12","children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-2","children":"Page Speed & Conversion"}],["$","h1",null,{"className":"heading-1 text-fg md:text-5xl","children":"Improve Page Speed to Boost Paid Traffic Conversion Rates"}],["$","p",null,{"className":"mt-4 text-lg text-fg-muted leading-relaxed max-w-2xl","children":"Speed failures eliminate conversion before the visitor reaches the CTA. LCP over 2.5s. HTML payloads that should be API calls. Render-blocking scripts that hold the page blank while executing. Desktop-resolution images on mobile viewports. Each failure has a measurable, observable cause - and a bounded fix."}],["$","div",null,{"className":"mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-3","children":[["$","$L1e",null,{"href":"/audit?utm_source=page-speed-hero&utm_medium=hero-cta","className":"inline-flex min-h-[44px] items-center justify-center rounded bg-accent px-6 py-3 text-sm font-semibold text-bg transition-opacity hover:opacity-85","children":"Get your free audit →"}],["$","$L1e",null,{"href":"/repair-sprint","className":"inline-flex min-h-[44px] items-center justify-center rounded border border-border px-5 py-3 text-sm font-medium text-fg-muted transition-colors hover:border-fg-muted hover:text-fg","children":"Explore $97 Repair Sprint"}]]}]]}],["$","section",null,{"className":"mb-14","children":[["$","h2",null,{"className":"text-2xl font-bold tracking-tight text-fg mb-6","children":"Six page speed conversion failures"}],["$","div",null,{"className":"space-y-4","children":[["$","div","0",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"01"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Core Web Vitals"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"LCP over 2.5s - hero content loads after visitors abandon"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"Largest Contentful Paint above 2.5s is the single most common speed failure on marketing landing pages. The LCP element is typically the hero image or the H1 - the first thing a visitor needs to see to confirm they are in the right place. When it loads after 2.5s, a measurable proportion of visitors have already navigated away. Google's own data shows that moving LCP from 2.4s to 3.3s increases the probability of abandonment by 32%. Paid traffic arriving from ads pays for this delay in wasted CPCs."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Preload the LCP element with a <link rel=\"preload\"> tag in the document head. If the LCP is an image, serve it in WebP or AVIF at the correct display size. If the LCP is a headline, ensure it is in the static HTML response - not rendered by JavaScript. Run the audit and check the reported LCP value against your actual page."}]]}]]}],["$","div","1",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"02"}],"$L27"]}],"$L28","$L29"]}],"$L2a","$L2b","$L2c","$L2d"]}]]}],"$L2e","$L2f","$L30","$L31"]}]}]
