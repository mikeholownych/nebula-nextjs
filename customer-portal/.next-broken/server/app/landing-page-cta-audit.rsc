1e:["$","section",null,{"className":"mb-14 rounded-md border border-border bg-bg-muted/30 p-8 text-center","children":[["$","h2",null,{"className":"text-2xl font-bold text-fg mb-3","children":"Audit your landing page CTA"}],["$","p",null,{"className":"text-sm text-fg-muted max-w-xl mx-auto mb-6","children":"Paste your URL. Nebula checks CTA label, placement, contrast, hierarchy, and post-click clarity against your actual page - not a template. Free, no signup, under 2 minutes."}],["$","$L27",null,{"href":"/audit?utm_source=content&utm_medium=organic-content","className":"inline-block rounded bg-accent px-8 py-4 font-semibold text-bg hover:opacity-85 hover:bg-accent transition-colors text-base","children":"Run Free CTA Audit →"}],["$","p",null,{"className":"mt-3 text-xs text-fg-muted","children":"No credit card required - results in under 2 minutes"}]]}]
1f:["$","section",null,{"className":"mb-14","children":[["$","h2",null,{"className":"text-2xl font-bold tracking-tight text-fg mb-6","children":"Common questions"}],["$","div",null,{"className":"space-y-4","children":[["$","div","0",{"className":"rounded-xl border border-border bg-bg-muted/20 p-5","children":[["$","h3",null,{"className":"text-sm font-semibold text-fg mb-2","children":"What makes a CTA label effective?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"The label should state what the visitor receives, not what they do. 'Submit' describes the action. 'Get my free audit' describes the outcome. Outcome-framed CTAs outperform action-framed ones because they remind the visitor why they're clicking at the moment of decision."}]]}],["$","div","1",{"className":"rounded-xl border border-border bg-bg-muted/20 p-5","children":[["$","h3",null,{"className":"text-sm font-semibold text-fg mb-2","children":"How many CTAs should a landing page have?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"One primary CTA per viewport section. Multiple CTAs at equal visual weight - typical on pages with 'Buy now', 'Learn more', 'See demo', and 'Contact us' all in the hero - create decision paralysis. One prominent primary action, one subdued secondary option maximum."}]]}],["$","div","2",{"className":"rounded-xl border border-border bg-bg-muted/20 p-5","children":[["$","h3",null,{"className":"text-sm font-semibold text-fg mb-2","children":"What contrast ratio does a CTA button need?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"WCAG AA requires 4.5:1 for normal text, 3:1 for large text. Most CTA buttons use large text, but the background-to-text contrast must still pass. A green button on a white background can fail if the green is too light. The audit checks the computed contrast ratio from your page's actual CSS."}]]}],["$","div","3",{"className":"rounded-xl border border-border bg-bg-muted/20 p-5","children":[["$","h3",null,{"className":"text-sm font-semibold text-fg mb-2","children":"Where should the CTA be placed on a landing page?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Above the fold on both desktop and mobile. Visitors who arrived from an ad have already expressed intent - they don't need to read the entire page before being offered the action. The CTA should be visible immediately, then repeated after the proof section."}]]}],["$","div","4",{"className":"rounded-xl border border-border bg-bg-muted/20 p-5","children":[["$","h3",null,{"className":"text-sm font-semibold text-fg mb-2","children":"What is 'CTA competition' and how does it hurt conversion?"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"CTA competition occurs when multiple clickable actions appear at equal visual weight in the same viewport, forcing the visitor to choose between them. The cognitive cost of the choice - Buy now? Learn more? Watch demo? Contact us? - delays or prevents the primary conversion action."}]]}]]}]]}]
