2c:["$","div",null,{"className":"border-t border-border/20 px-6 py-4","children":["$","div",null,{"className":"mx-auto max-w-6xl flex flex-col md:flex-row justify-between items-center gap-2 text-xs text-fg-dim","children":[["$","p",null,{"children":["© ",2026," Nebula Components. All rights reserved."]}],["$","nav",null,{"aria-label":"Legal","className":"flex gap-4","children":[["$","$L27",null,{"href":"/privacy-policy","className":"hover:text-fg-muted transition-colors","children":"Privacy"}],["$","$L27",null,{"href":"/terms","className":"hover:text-fg-muted transition-colors","children":"Terms"}],["$","$L27",null,{"href":"/data-rights","className":"hover:text-fg-muted transition-colors","children":"Data Rights"}]]}]]}]}]
30:["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"CTA Mobile Visibility"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"Primary CTA not visible on 375px viewport without scroll"}]]}]
31:["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"On a 375px viewport - the standard benchmark for mobile - the primary CTA must be visible without scrolling. Pages that push the CTA below a large hero image, a headline, a subheadline, a feature list, and a trust strip have effectively hidden the primary action from mobile visitors. Mobile accounts for 60-70% of paid traffic on most campaigns. A CTA that requires scroll on mobile is functionally absent for the majority of ad-driven visitors."}]
32:["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Load the page at 375px width and measure the CTA position. The button should be fully visible in the initial viewport. If it is not, reduce the hero height, collapse the feature list to a single line, or move the CTA above the supporting copy."}]]}]
33:["$","div","3",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"04"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"CTA Contrast"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"Button contrast ratio fails WCAG AA at 4.5:1"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"WCAG AA compliance requires a minimum 4.5:1 contrast ratio between the button label text and the button background color. Many landing pages use brand-matched CTAs - light green on white, soft blue on light grey - that fail this threshold. The failure is not purely an accessibility concern: low-contrast CTAs are visually recessive and attract less attention than high-contrast ones. The audit measures the actual computed contrast ratio from the rendered CSS, not the intended design spec."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Run the button through a contrast checker with the exact background and text hex values. If the ratio is below 4.5:1, darken the background or lighten the text until it passes. A high-contrast CTA - dark text on a bright teal, white text on a dark button - is also higher-attention."}]]}]]}]
34:["$","div","4",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"05"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"CTA Placement"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"CTA placed below the fold on desktop"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"On a 1024px or 1280px desktop viewport, the primary CTA must be visible without scrolling. Visitors arriving from paid ads have already expressed intent - the ad pre-qualified them. They do not need to read the entire page before being offered the conversion action. Pages that lead with a 600px hero image, a navigation strip, a value proposition, and three feature icons before the CTA have placed the most important element after the point where most visitors stop reading."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Move the primary CTA into the hero section. It should appear alongside or directly below the H1 on both desktop and mobile. The CTA can be repeated further down the page after the proof section, but the first instance must be above the fold."}]]}]]}]
35:["$","div","5",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"06"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Post-Click Clarity"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"No indication of what happens after the click"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"The CTA button is not the final decision point - the visitor is also deciding whether the post-click commitment is acceptable. A button labeled 'Get started' with no surrounding context leaves the visitor uncertain: Will I be asked for a credit card? Will I enter a sales queue? Will this take 30 minutes? Micro-copy adjacent to the CTA - 'No credit card required', 'Takes 90 seconds', 'No sales call' - reduces the perceived commitment cost at the exact moment of decision."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Add one line of micro-copy directly below or beside the CTA button. It should address the most likely objection. For free tools: 'No signup required'. For trials: 'No credit card - cancel anytime'. For audits: 'Results in under 2 minutes'. Keep it under 10 words."}]]}]]}]
36:["$","p",null,{"className":"text-xs text-fg-muted leading-5","children":[["$","span",null,{"className":"text-signal-fail","children":"Fail: "}],"No context on what happens after the click"]}]
