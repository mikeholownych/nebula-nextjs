2a:["$","div",null,{"className":"border-t border-border/20 px-6 py-4","children":["$","div",null,{"className":"mx-auto max-w-6xl flex flex-col md:flex-row justify-between items-center gap-2 text-xs text-fg-dim","children":[["$","p",null,{"children":["© ",2026," Nebula Components. All rights reserved."]}],["$","nav",null,{"aria-label":"Legal","className":"flex gap-4","children":[["$","$L25",null,{"href":"/privacy-policy","className":"hover:text-fg-muted transition-colors","children":"Privacy"}],["$","$L25",null,{"href":"/terms","className":"hover:text-fg-muted transition-colors","children":"Terms"}],["$","$L25",null,{"href":"/data-rights","className":"hover:text-fg-muted transition-colors","children":"Data Rights"}]]}]]}]}]
2e:["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Visual Hierarchy"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"3–4 equal-weight actions competing - visitor faces paralysis, not a decision"}]]}]
2f:["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"Multiple CTAs at equal visual weight - 'Start Free Trial', 'Book a Demo', 'Watch Video', 'See Pricing' - split visitor attention. Each additional option reduces the probability that any single one gets clicked. The heuristic is Hick's Law: decision time scales with the number of choices. For cold traffic, one dominant CTA with everything else visually subordinate converts better than a row of equal options."}]
30:["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Choose one primary CTA for the hero. Secondary options (demo link, pricing anchor) can live in the nav or below the fold at a lower visual weight - smaller text, ghost button, or plain link. The primary CTA should be the only filled button in the hero."}]]}]
31:["$","div","3",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"04"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Visual Design"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"Low contrast - button color blends into the background, invisible at a glance"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"A CTA button that matches the page's color palette disappears into the layout. This happens most often when designers use the brand primary color for both background elements and the CTA - the button earns no separation. The squint test is the fastest diagnostic: blur your eyes at the page. If the CTA button is not the first element your eye lands on, the contrast is insufficient. Dark pages with dark-green CTAs are the most common offender."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"The CTA button should be the highest-contrast element in the hero. On dark backgrounds, a bright accent - white, amber, or high-saturation green - outperforms a brand-tinted dark button. Run the squint test after every design change: the button should still be obvious when the page is visually blurred."}]]}]]}]
32:["$","div","4",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"05"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Trust Signals"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"No friction removal - CTA stands alone with no 'no card required' or time estimate adjacent"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"The moment a visitor considers clicking, objections activate: 'Do I need a credit card?', 'How long will this take?', 'Am I committing to something?' A CTA with no adjacent reassurance forces visitors to resolve these objections on their own - most don't. A single line of micro-copy beneath the button ('No card required · Results in 2 minutes') handles the two most common objections at the point of peak intent."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Add one friction-removal line directly below the primary CTA button. Name the barrier your ICP is most likely to hesitate on - for free tools, it's credit card concern; for audits and reports, it's time commitment. Keep it under 8 words."}]]}]]}]
33:["$","div","5",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"06"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Interaction Design"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"Generic hover state - no visual confirmation the button responds to interaction"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"A CTA button with no hover or focus state looks static - it does not signal that the element is interactive. This matters most for first-time visitors on desktop, who move their cursor over the button before clicking. A static button creates a half-second of uncertainty ('Is this clickable?') that breaks the micro-commitment arc. It also fails WCAG 2.1 AA focus-visible requirements for keyboard navigation."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Add a visible transition on hover and focus: background color shift, slight scale (scale-[1.02]), or shadow change. The transition should complete in 150–200ms. Ensure the focus ring is visible for keyboard users - this is a compliance requirement, not optional polish."}]]}]]}]
34:["$","p",null,{"className":"text-xs text-fg-muted leading-5","children":[["$","span",null,{"className":"text-signal-fail","children":"Fail: "}],"Static button - no state change on interaction"]}]
