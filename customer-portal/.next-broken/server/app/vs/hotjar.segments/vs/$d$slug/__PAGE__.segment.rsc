ext-fg","children":["What is the difference between Hotjar and Nebula?",["$","span",null,{"aria-hidden":"true","className":"shrink-0 text-accent transition-transform group-open:rotate-45","children":"+"}]]}],["$","p",null,{"className":"mt-3 text-fg-muted leading-relaxed","children":"Hotjar is a post-launch behavior tool (heatmaps, recordings, surveys) that needs traffic and time. Nebula is a pre-conversion diagnostic that scores the page's conversion structure - message match, CTA, trust, above-fold - before you burn ad spend."}]]}]]}]]}]
1e:T456,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Does Hotjar require existing traffic?","acceptedAnswer":{"@type":"Answer","text":"Yes - heatmaps, recordings, and scrollmaps only generate from real visitor sessions. A new landing page with little traffic produces little data. Nebula audits any public URL immediately, with no traffic required."}},{"@type":"Question","name":"Can Hotjar tell me why my page does not convert?","acceptedAnswer":{"@type":"Answer","text":"Hotjar shows behavior - where people click, scroll, and leave - but does not diagnose the cause. If the headline does not match the ad, Hotjar shows visitors leaving; Nebula names the message-match failure and the fix."}},{"@type":"Question","name":"What is the difference between Hotjar and Nebula?","acceptedAnswer":{"@type":"Answer","text":"Hotjar is a post-launch behavior tool (heatmaps, recordings, surveys) that needs traffic and time. Nebula is a pre-conversion diagnostic that scores the page's conversion structure - message match, CTA, trust, above-fold - before you burn ad spend."}}]}f:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1e"}}]
