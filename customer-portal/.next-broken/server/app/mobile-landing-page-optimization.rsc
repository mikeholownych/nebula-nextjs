2a:["$","div",null,{"className":"border-t border-border/20 px-6 py-4","children":["$","div",null,{"className":"mx-auto max-w-6xl flex flex-col md:flex-row justify-between items-center gap-2 text-xs text-fg-dim","children":[["$","p",null,{"children":["© ",2026," Nebula Components. All rights reserved."]}],["$","nav",null,{"aria-label":"Legal","className":"flex gap-4","children":[["$","$L25",null,{"href":"/privacy-policy","className":"hover:text-fg-muted transition-colors","children":"Privacy"}],["$","$L25",null,{"href":"/terms","className":"hover:text-fg-muted transition-colors","children":"Terms"}],["$","$L25",null,{"href":"/data-rights","className":"hover:text-fg-muted transition-colors","children":"Data Rights"}]]}]]}]}]
2e:["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"iOS Safari automatically zooms the viewport when the user taps an input field if the font size is below 16px. This breaks fixed-position elements, disrupts scroll behavior, and shifts the layout in ways that can hide the CTA. Body copy below 16px also fails basic readability on a 375px screen at arm's length - the visitor cannot comfortably read the offer, so they do not act on it."}]
2f:["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Set body font-size to 16px minimum. Set all form input and textarea font-size to 16px or above - this specifically prevents iOS auto-zoom. Check computed font sizes using Chrome DevTools Computed panel at 390px width."}]]}]
30:["$","div","3",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"04"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Images"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"Desktop-sized images - 1200px asset on 375px viewport wastes bandwidth and LCP"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"A hero image sized for a 1200px desktop layout sent to a 375px mobile viewport is roughly 3× wider than necessary. The browser downloads and decodes 3× the pixel data. On a 4G connection, an unoptimized image that is 800KB can add 2–3 seconds to Largest Contentful Paint. LCP is Google's primary user-experience ranking signal. Slow LCP on mobile increases bounce rate before the page is even interactive."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Use the <picture> element with srcset breakpoints, or serve images through a CDN that delivers appropriately sized variants by device. Target 375–430px images under 150KB for above-fold hero assets. Run a WebPageTest or Lighthouse audit on a throttled mobile connection to verify LCP improvement."}]]}]]}]
31:["$","div","4",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"05"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Forms"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"No autocomplete on forms - email field without type=\"email\" loses mobile keyboard"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"An <input> element without type=\"email\" renders a standard QWERTY keyboard on iOS, not the email-optimized keyboard with @ and .com keys. An input without autocomplete=\"email\" skips the system's stored credential suggestions. Each missing attribute adds friction to form completion on mobile. A three-field form with no autocomplete on any field multiplies the friction across every field."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Set type=\"email\" on every email input. Set autocomplete attributes explicitly: autocomplete=\"email\", autocomplete=\"name\", autocomplete=\"tel\". Verify that the correct keyboard appears on device for each field. On a standard iOS device, type=\"email\" should surface the keyboard with @ visible as a primary key."}]]}]]}]
32:["$","div","5",{"className":"rounded-xl border border-border bg-bg-muted/20 p-6","children":[["$","div",null,{"className":"flex items-start gap-3 mb-3","children":[["$","span",null,{"className":"shrink-0 font-mono text-xs text-fg-dim mt-0.5","children":"06"}],["$","div",null,{"children":[["$","p",null,{"className":"text-xs font-semibold uppercase tracking-wider text-accent mb-0.5","children":"Layout"}],["$","h3",null,{"className":"text-base font-semibold text-fg","children":"Horizontal overflow - content wider than viewport creates sideways scroll"}]]}]]}],["$","p",null,{"className":"text-sm text-fg-muted leading-6 mb-3 pl-7","children":"A single oversized element - a fixed-width table, an unscaled image, a wide code block, or an element with a hardcoded pixel width - forces the viewport to expand horizontally. The user can now scroll left and right, which breaks the expected vertical reading flow. Trust badges, comparison tables, and icon rows with too many columns are the most common sources of horizontal overflow on landing pages."}],["$","div",null,{"className":"pl-7 border-l-2 border-accent/30 ml-7","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm text-fg-muted leading-6","children":"Add overflow-x: hidden to the body element to suppress horizontal scroll. Then trace the source: open Chrome DevTools at 390px and inspect elements wider than the viewport. Fix the root cause - use max-width: 100% on images, replace fixed pixel widths with relative widths, and limit icon rows to three columns on mobile."}]]}]]}]
33:["$","p",null,{"className":"text-xs text-fg-muted leading-5","children":[["$","span",null,{"className":"text-signal-fail","children":"Fail: "}],"Fixed-width table or image forces sideways scroll"]}]
