23:[["$","title","0",{"children":"Mobile Landing Page Optimization: Fix 6 Leaks | Nebula"}],["$","meta","1",{"name":"description","content":"Most mobile landing page failures are structural - CTA below fold, tap targets under 44px, text that triggers iOS auto-zoom. Each is observable and fixable. This guide covers all six with pass/fail evidence."}],["$","link","2",{"rel":"manifest","href":"/manifest.webmanifest","crossOrigin":"$undefined"}],["$","link","3",{"rel":"canonical","href":"https://nebulacomponents.com/mobile-landing-page-optimization"}],["$","meta","4",{"property":"og:title","content":"Mobile Landing Page Optimization: Fix 6 Leaks | Nebula"}],["$","meta","5",{"property":"og:description","content":"Most mobile landing page failures are structural - CTA below fold, tap targets under 44px, text that triggers iOS auto-zoom. Each is observable and fixable."}],["$","meta","6",{"property":"og:url","content":"https://nebulacomponents.com/mobile-landing-page-optimization"}],["$","meta","7",{"property":"og:site_name","content":"Nebula Components"}],["$","meta","8",{"property":"og:image","content":"https://nebulacomponents.com/brand/v2/og-default.png"}],["$","meta","9",{"property":"og:type","content":"article"}],["$","meta","10",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","11",{"name":"twitter:title","content":"Mobile Landing Page Optimization: Fix 6 Leaks | Nebula"}],["$","meta","12",{"name":"twitter:description","content":"Most mobile landing page failures are structural - CTA below fold, tap targets under 44px, text that triggers iOS auto-zoom. Each is observable and fixable."}],["$","meta","13",{"name":"twitter:image","content":"https://nebulacomponents.com/brand/v2/og-default.png"}],["$","link","14",{"rel":"shortcut icon","href":"/favicon.svg"}],["$","link","15",{"rel":"icon","href":"/favicon.svg","type":"image/svg+xml"}],["$","link","16",{"rel":"icon","href":"/brand/v2/favicon-32.png","sizes":"32x32","type":"image/png"}],["$","link","1