0:{"buildId":"iNWCfX8KG4iu7ETtWBmLh","data":[{"rsc":["$","$1","c",{"children":[["$","main",null,{"id":"main-content","className":"min-h-screen bg-bg pt-24","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Bridge the TikTok Scroll-Speed Gap to Boost Mobile Conversions\",\"description\":\"TikTok rewards rapid pass/fail decisions. Your landing page wasn't built for that. Here's the scroll-speed gap that blocks conversions - and how to fix it before you scale spend.\",\"author\":{\"@id\":\"https://nebulacomponents.com/#founder\"},\"datePublished\":\"2026-07-25\",\"dateModified\":\"2026-07-25\",\"publisher\":{\"@id\":\"https://nebulacomponents.com/#organization\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://nebulacomponents.com/learning-centre/tiktok-landing-page-scroll-speed-gap\"},\"image\":\"https://nebulacomponents.com/opengraph-image\"}"}}],["$","div",null,{"className":"mx-auto max-w-3xl px-4 pb-24","children":[["$","nav",null,{"className":"mb-6 flex items-center gap-2 text-sm text-fg-muted","aria-label":"Breadcrumb","children":[["$","$L2",null,{"href":"/","className":"hover:text-accent transition-colors","children":"Home"}],["$","span",null,{"children":"/"}],["$","$L2",null,{"href":"/learning-centre","className":"hover:text-accent transition-colors","children":"Learning Centre"}],["$","span",null,{"children":"/"}],["$","span",null,{"className":"text-fg","children":"TikTok Scroll-Speed Gap"}]]}],["$","header",null,{"className":"mb-8","children":[["$","div",null,{"className":"mb-3 flex items-center gap-2","children":["$","span",null,{"className":"rounded-full bg-accent/10 px-3 py-1 text-xs font-medium text-accent","children":"TikTok Ads Leaks"}]}],["$","h1",null,{"className":"mb-4 text-3xl font-bold leading-tight text-fg sm:text-4xl","children":"Bridge the TikTok Scroll-Speed Gap to Boost Mobile Conversions"}],["$","p",null,{"className":"text-lg leading-relaxed text-fg-muted","children":"TikTok has conditioned your audience to make pass/fail decisions in under a second. Most landing pages were never designed for that pace - and the mismatch silently drains your ad budget long before you notice the pattern."}],["$","div",null,{"className":"mt-6 flex flex-col sm:flex-row items-stretch sm:items-center gap-3","children":[["$","$L2",null,{"href":"/audit?utm_source=learning-centre-tiktok-landing-page-scroll-speed-gap&utm_medium=hero-cta","className":"inline-flex min-h-[44px] items-center justify-center rounded bg-accent px-6 py-3 text-sm font-semibold text-bg transition-opacity hover:opacity-85","children":"Get your free audit →"}],["$","$L2",null,{"href":"/repair-sprint","className":"inline-flex min-h-[44px] items-center justify-center rounded border border-border px-5 py-3 text-sm font-medium text-fg-muted transition-colors hover:border-fg-muted hover:text-fg","children":"Explore $97 Repair Sprint"}]]}],["$","p",null,{"className":"mt-3 text-sm text-fg-muted","children":["Published ",["$","time",null,{"dateTime":"2026-07-25","children":"25 July 2026"}]]}]]}],["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-xl font-semibold text-fg","children":"The Attention Cadence Mismatch"}],["$","p",null,{"className":"mb-4 leading-relaxed text-fg-muted","children":"TikTok is a machine for training fast judgment. The average user makes a scroll-or-stay decision very quickly after a new piece of content appears. After thousands of those micro-decisions per week, the reflex becomes automatic - stop only if something earns it immediately, keep scrolling if there is any friction or ambiguity."}],["$","p",null,{"className":"mb-4 leading-relaxed text-fg-muted","children":"Compare that to Google Search traffic. Someone who types a query has already declared intent. They arrived at your page with a reason. They are prepared to read, evaluate, and decide at a measured pace. The psychological contract is completely different."}],"$L3","$L4"]}],"$L5","$L6","$L7","$L8","$L9","$La","$Lb"]}]]}],null,"$Lc"]}],"isPartial":"$@d","staleTime":"$e","varyParams":null},{"rsc":"$Lf","isPartial":"$@10","staleTime":"$e","varyParams":null},{"rsc":"$L11","isPartial":"$@12","staleTime":"$e","varyParams":"$13"},{"rsc":"$L14","isPartial":"$@15","staleTime":"$e","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@16","rootVaryParams":null,"needsRuntimeRequest":"$@17"}
