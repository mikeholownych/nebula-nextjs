0:{"buildId":"iNWCfX8KG4iu7ETtWBmLh","data":[{"rsc":["$","$1","c",{"children":[["$","main",null,{"id":"main-content","className":"min-h-screen bg-bg pt-24","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Bridge the LinkedIn Authority Gap to Boost B2B Landing Pages\",\"description\":\"Why high-credential LinkedIn audiences bounce from pages that convert Facebook traffic - and the specific checks you need before scaling LinkedIn spend.\",\"author\":{\"@id\":\"https://nebulacomponents.com/#founder\"},\"datePublished\":\"2026-07-25\",\"dateModified\":\"2026-07-25\",\"publisher\":{\"@id\":\"https://nebulacomponents.com/#organization\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://nebulacomponents.com/learning-centre/linkedin-authority-gap\"},\"image\":\"https://nebulacomponents.com/opengraph-image\"}"}}],["$","div",null,{"className":"mx-auto max-w-3xl px-4 pb-24","children":[["$","nav",null,{"className":"mb-6 text-sm text-fg-muted","aria-label":"Breadcrumb","children":[["$","$L2",null,{"href":"/learning-centre","className":"hover:text-fg transition-colors","children":"Learning Centre"}],["$","span",null,{"className":"mx-2","children":"/"}],["$","span",null,{"children":"LinkedIn Ads Leaks"}],["$","span",null,{"className":"mx-2","children":"/"}],["$","span",null,{"children":"LinkedIn Authority Gap"}]]}],["$","header",null,{"className":"mb-8","children":[["$","p",null,{"className":"mb-3 text-sm font-medium uppercase tracking-widest text-accent","children":"LinkedIn Ads Leaks"}],["$","h1",null,{"className":"mb-4 text-3xl font-bold leading-tight text-fg md:text-4xl","children":"Bridge the LinkedIn Authority Gap to Boost B2B Landing Pages"}],["$","p",null,{"className":"text-lg leading-relaxed text-fg-muted","children":"LinkedIn CPCs are 3–5× Facebook. If your landing page was built for impulse-driven audiences, you are burning budget on visitors who are actively evaluating you - and finding nothing convincing enough to stay."}],["$","div",null,{"className":"mt-6 flex flex-col sm:flex-row items-stretch sm:items-center gap-3","children":[["$","$L2",null,{"href":"/audit?utm_source=learning-centre-linkedin-authority-gap&utm_medium=hero-cta","className":"inline-flex min-h-[44px] items-center justify-center rounded bg-accent px-6 py-3 text-sm font-semibold text-bg transition-opacity hover:opacity-85","children":"Get your free audit →"}],["$","$L2",null,{"href":"/repair-sprint","className":"inline-flex min-h-[44px] items-center justify-center rounded border border-border px-5 py-3 text-sm font-medium text-fg-muted transition-colors hover:border-fg-muted hover:text-fg","children":"Explore $97 Repair Sprint"}]]}]]}],["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-xl font-semibold text-fg","children":"The LinkedIn Visitor Mental Model"}],["$","p",null,{"className":"mb-4 leading-relaxed text-fg-muted","children":["A LinkedIn visitor arrives in a fundamentally different cognitive state than a Facebook visitor. They are not impulse-browsing. They have seen an ad in a professional context, evaluated it against their current work problem, and made an active decision to click. That means they arrive as a ",["$","em",null,{"children":"vendor evaluator"}],", not a passive consumer."]}],["$","p",null,{"className":"mb-4 leading-relaxed text-fg-muted","children":"The professional credibility filter is on before the page loads. They are asking: Is this company credible enough to take seriously? Does this solution look like something my peers would consider? Would I be embarrassed to forward this to my CFO? Pages that pass the Facebook scroll-stop test often fail this 10-second professional evaluation instantly."}],"$L3"]}],"$L4","$L5","$L6","$L7","$L8","$L9","$La"]}]]}],null,"$Lb"]}],"isPartial":"$@c","staleTime":"$d","varyParams":null},{"rsc":"$Le","isPartial":"$@f","staleTime":"$d","varyParams":null},{"rsc":"$L10","isPartial":"$@11","staleTime":"$d","varyParams":"$12"},{"rsc":"$L13","isPartial":"$@14","staleTime":"$d","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@15","rootVaryParams":null,"needsRuntimeRequest":"$@16"}
