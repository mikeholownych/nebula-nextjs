3:["$","div",null,{"className":"mt-5 flex flex-col gap-2 text-sm","children":[["$","$L2",null,{"href":"/learning-centre/linkedin-authority-gap","className":"font-semibold text-accent hover:text-fg","children":"Inspect the LinkedIn authority gap"}],["$","$L2",null,{"href":"/learning-centre/b2b-saas-landing-page-not-converting","className":"font-semibold text-accent hover:text-fg","children":"Diagnose a B2B SaaS landing page"}]]}]
4:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"The Cost of Every Page Leak Is Amplified on LinkedIn"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"Use your own CPC and observed conversion rate to model the post-click cost. For illustration, 100 clicks at a $10 CPC cost $1,000: two recorded conversions imply $500 of media spend per conversion, while five imply $200. This is arithmetic, not a LinkedIn benchmark or forecast."}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"Run this calculation before anything else: what is your current cost-per-lead from LinkedIn? Now divide that by your close rate. That's your cost-per-acquisition. If that number is unsustainable, the first place to look is your landing page conversion rate - not your bid strategy, not your audience segments."}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"Model several conversion-rate scenarios with your actual spend, then validate any observed change against the same conversion definition and a comparable traffic period. Do not present a modelled saving as a measured result."}]]}]
5:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"B2B Decision Makers Need Peer Proof, Not Feature Lists"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"The professional scrolling LinkedIn is not evaluating your product emotionally - they're evaluating risk. A VP of Marketing who clicks your ad is asking: \"Will this embarrass me if I recommend it? Will it actually do what it claims? Has anyone like me used it and gotten results?\""}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"A feature-led page may leave those questions unanswered when proof is generic or detached from the audience named in the ad. Inspect whether each proof point identifies the customer context and the source of any claimed result."}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"Evidence formats to evaluate for LinkedIn traffic:"}],["$","ul",null,{"className":"mt-3 space-y-2 text-fg-muted","children":[["$","li",null,{"className":"flex gap-2","children":[["$","span",null,{"className":"text-accent font-bold shrink-0","children":"-"}],["$","span",null,{"children":"Named testimonials with job title, company size, and specific outcome (\"reduced churn 22% in Q1\")"}]]}],["$","li",null,{"className":"flex gap-2","children":[["$","span",null,{"className":"text-accent font-bold shrink-0","children":"-"}],["$","span",null,{"children":"Logos of recognisable companies in your ICP's peer group - not just any logo wall"}]]}],["$","li",null,{"className":"flex gap-2","children":[["$","span",null,{"className":"text-accent font-bold shrink-0","children":"-"}],["$","span",null,{"children":"Case study snippets with measurable results, not narrative prose"}]]}],["$","li",null,{"className":"flex gap-2","children":[["$","span",null,{"className":"text-accent font-bold shrink-0","children":"-"}],["$","span",null,{"children":"Proof visible before the CTA - not after it"}]]}]]}]]}]
6:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"The Demo Request Is Too High-Commitment for Cold Traffic"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"A common LinkedIn ad funnel sends awareness traffic directly to a “Book a Demo” page. That CTA may fit a re-engagement touchpoint, but it can be a high-commitment first step for visitors seeing the brand for the first time."}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"A B2B decision maker clicking during the workday may not be ready to commit to a sales call. That makes CTA architecture a variable to test:"}],["$","ul",null,{"className":"mt-3 space-y-2 text-fg-muted","children":[["$","li",null,{"className":"flex gap-2","children":[["$","span",null,{"className":"text-accent font-bold shrink-0","children":"-"}],["$","span",null,{"children":"Compare a specific guide with the current demo request for the same traffic segment"}]]}],["$","li",null,{"className":"flex gap-2","children":[["$","span",null,{"className":"text-accent font-bold shrink-0","children":"-"}],["$","span",null,{"children":"Test whether a relevant tool or assessment better matches the ad's promised next step"}]]}],["$","li",null,{"className":"flex gap-2","children":[["$","span",null,{"className":"text-accent font-bold shrink-0","children":"-"}],["$","span",null,{"children":"If you must ask for a demo, the page needs to do significant proof-of-value work before that ask lands"}]]}]]}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"If your LinkedIn ads go to a \"Book a Demo\" page with no prior warm-up content on that page, test conversion architecture as one hypothesis. Campaign targeting, offer fit, and post-click experience still need separate evidence."}]]}]
7:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Message Match: The Ad Made a Promise, The Page Must Keep It"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"LinkedIn lets you target with precision: seniority, function, company size, industry. You can show a CFO at a 200-person SaaS company a specific ad about financial reporting. That ad created a specific expectation about what the landing page would contain."}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"If that CFO lands on a generic homepage or a generic product page that doesn't echo the specific language, promise, and audience framing of the ad - the implicit contract is broken. They don't see the page as relevant to them. They leave."}],["$","p",null,{"className":"mt-4 leading-relaxed text-fg-muted","children":"Diagnose your message match by reading the headline of your ad, then reading the headline of your landing page. Ask: does the landing page headline feel like the logical continuation of the ad's promise? The specific outcome named in the ad should be reflected - not paraphrased, reflected - in the above-fold copy of the page."}]]}]
8:["$","section",null,{"className":"mt-6 rounded-2xl border border-accent/40 bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Find the leak on your page"}],["$","p",null,{"className":"mb-6 leading-relaxed text-fg-muted","children":"Run the free Nebula audit to see exactly where your page breaks the chain from click to conversion."}],["$","div",null,{"className":"flex flex-wrap gap-4","children":[["$","$L2",null,{"href":"/audit?utm_source=learning-centre&utm_medium=organic-content","className":"inline-flex rounded bg-accent px-6 py-3 font-semibold text-bg hover:opacity-85 hover:bg-accent transition-colors","children":"Run the free audit"}],["$","$L2",null,{"href":"/learning-centre","className":"inline-flex rounded border border-accent px-6 py-3 font-semibold text-accent hover:bg-accent-dim transition-colors","children":"Browse all leaks"}]]}]]}]
