11:["$","details",null,{"className":"mb-4","children":[["$","summary",null,{"className":"cursor-pointer text-xs font-semibold uppercase tracking-wide text-fg-muted hover:text-accent transition-colors","children":"Why this causes the loss ↓"}],["$","p",null,{"className":"mt-2 text-sm leading-relaxed text-fg-muted pl-2 border-l border-border","children":"Google's Quality Score algorithm uses message match as a signal for Landing Page Experience. A poor match raises your effective CPC in the ad auction - meaning you pay a premium per click to drive traffic to a page that then fails immediately. The leak costs twice: once in wasted clicks, once in higher cost per click."}]]}]
12:["$","div",null,{"className":"rounded-lg bg-accent/5 border border-accent/20 p-4 mb-4","children":[["$","p",null,{"className":"text-xs font-bold uppercase tracking-wide text-accent mb-1","children":"Fix"}],["$","p",null,{"className":"text-sm leading-relaxed text-fg-muted","children":"Mirror the exact noun phrase from your top-traffic ad groups in the page H1. If the ad is targeting \"landing page audit tool\" and the H1 says \"Transform Your Marketing,\" the visitor cannot confirm they are in the right place. Change the H1 to echo the keyword - exactly or semantically. Do this for every major ad group separately if volume justifies it."}]]}]
