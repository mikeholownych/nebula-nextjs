2a:["$","p",null,{"className":"mt-1 leading-relaxed text-fg-muted","children":"If your Google Ads search CTR is below 3-5% on high-intent keywords, the ad is the problem - not the page. Visitors are not clicking. No amount of page optimisation fixes an ad that does not get clicked."}]
2b:["$","li","Bounce rate by source",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg","children":"Bounce rate by source"}],["$","p",null,{"className":"mt-1 leading-relaxed text-fg-muted","children":"Segment analytics by traffic source. If paid search bounces at 80% but email or direct traffic converts at 8%, the page structure is not the issue - the message-match between the ad and the page is. If all sources bounce equally at 80%+, the page itself is broken."}]]}]
2c:["$","li","Time-on-page for bouncers",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg","children":"Time-on-page for bouncers"}],["$","p",null,{"className":"mt-1 leading-relaxed text-fg-muted","children":"Under 5 seconds: load time or immediate message mismatch. The visitor did not stay long enough to read the headline. 15–30 seconds: the visitor read the page but was not convinced. The problem is proof, CTA, or offer - not the above-fold section."}]]}]
2d:["$","li","Device split",{"className":"border-b border-border pb-4 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg","children":"Device split"}],["$","p",null,{"className":"mt-1 leading-relaxed text-fg-muted","children":"If mobile bounces 20+ percentage points above desktop, the cause is mobile layout or mobile load time - not the audience. Paid social traffic is predominantly mobile. Fix mobile layout before attributing the problem to traffic quality."}]]}]
2e:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"The 9-signal pre-spend checklist"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"Run these in order. The signals are sequenced: a visitor who bounces on signal 1 never reaches signal 5. Fix in order - earlier signals gate later ones."}],["$","ol",null,{"className":"mt-6 space-y-5","children":[["$","li","Message match",{"className":"rounded-xl border border-border bg-bg-muted/10 p-5","children":[["$","div",null,{"className":"flex items-center gap-3 mb-2","children":[["$","span",null,{"className":"shrink-0 text-xs font-bold text-accent bg-accent/10 rounded-full w-6 h-6 flex items-center justify-center","children":1}],["$","p",null,{"className":"font-semibold text-fg","children":["Signal ",1,": ","Message match"]}]]}],["$","p",null,{"className":"text-sm leading-relaxed text-fg-muted pl-9","children":"Does the page headline use the same noun phrase as the ad that brought the visitor there? If the ad says \"Fix your landing page\" and the H1 says \"Welcome to Acme Inc.\", the chain is broken at arrival."}]]}],["$","li","Trust",{"className":"rounded-xl border border-border bg-bg-muted/10 p-5","children":[["$","div",null,{"className":"flex items-center gap-3 mb-2","children":[["$","span",null,{"className":"shrink-0 text-xs font-bold text-accent bg-accent/10 rounded-full w-6 h-6 flex items-center justify-center","children":2}],["$","p",null,{"className":"font-semibold text-fg","children":["Signal ",2,": ","Trust"]}]]}],["$","p",null,{"className":"text-sm leading-relaxed text-fg-muted pl-9","children":"Is there specific proof visible before the primary CTA? A named customer result, a recognisable logo, or a specific outcome number. Generic \"5-star rated\" claims without context do not count as trust signals."}]]}],["$","li","Mobile CTA",{"className":"rounded-xl border border