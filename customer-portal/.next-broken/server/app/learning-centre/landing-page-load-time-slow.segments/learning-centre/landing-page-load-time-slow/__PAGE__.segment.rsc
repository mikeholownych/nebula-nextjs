13:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"The thresholds that matter: LCP"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"Largest Contentful Paint (LCP) measures when the main content element - usually the hero image or headline - becomes visible. For a landing page, this is the moment the visitor can actually evaluate whether they are in the right place."}],["$","ul",null,{"className":"mt-5 space-y-3","children":[["$","li","LCP under 2.5s",{"className":"flex items-start gap-4 rounded-xl border border-border p-4","children":[["$","div",null,{"className":"shrink-0 w-32","children":[["$","p",null,{"className":"text-sm font-semibold text-fg","children":"LCP under 2.5s"}],["$","p",null,{"className":"text-xs font-bold uppercase text-green-400","children":"Good"}]]}],["$","p",null,{"className":"text-sm leading-relaxed text-fg-muted","children":"Most visitors see your offer quickly. This is the target for paid traffic landing pages."}]]}],["$","li","LCP 2.5s–4s",{"className":"flex items-start gap-4 rounded-xl border border-border p-4","children":[["$","div",null,{"className":"shrink-0 w-32","children":[["$","p",null,{"className":"text-sm font-semibold text-fg","children":"LCP 2.5s–4s"}],["$","p",null,{"className":"text-xs font-bold uppercase text-yellow-400","children":"Needs improvement"}]]}],["$","p",null,{"className":"text-sm leading-relaxed text-fg-muted","children":"You are losing impatient visitors. Fix before scaling ad spend."}]]}],["$","li","LCP above 4s",{"className":"flex items-start gap-4 rounded-xl border border-border p-4","children":[["$","div",null,{"className":"shrink-0 w-32","children":[["$","p",null,{"className":"text-sm font-semibold text-fg","children":"LCP above 4s"}],["$","p",null,{"className":"text-xs font-bold uppercase text-red-400","children":"Poor"}]]}],["$","p",null,{"className":"text-sm leading-relaxed text-fg-muted","children":"You are bleeding conversions and Search ranking. This is the first thing to fix."}]]}]]}],["$","p",null,{"className":"mt-4 text-sm text-fg-muted","children":["Check your LCP free at"," ",["$","a",null,{"href":"https://pagespeed.web.dev","className":"text-accent hover:text-fg underline","target":"_blank","rel":"noopener noreferrer","children":"pagespeed.web.dev"}],". Enter your landing page URL. Takes under two minutes. Run the mobile test - not just desktop."]}]]}]
14:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"The 4 most common causes of slow LCP"}],["$","div",null,{"className":"space-y-5","children":[["$","div","0",{"className":"border-b border-border pb-5 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg","children":"Uncompressed hero image"}],["$","p",null,{"className":"mt-2 leading-relaxed text-fg-muted","children":"Convert to WebP format. Compress to 80% quality - indistinguishable from lossless at normal screen sizes. Serve responsive images (srcset) so mobile gets a smaller file than desktop. A 2MB PNG hero becomes 150–200KB WebP. This alone fixes LCP in most cases."}]]}],["$","div","1",{"className":"border-b border-border pb-5 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg","children":"Render-blocking third-party scripts"}],["$","p",null,{"className":"mt-2 leading-relaxed text-fg-muted","children":"Chat widgets, ad pixels, analytics tags, and A/B testing tools loaded in the <head> block rendering until they resolve. Audit with Chrome DevTools Network tab. Defer or async-load any script that is not required for initial render. Each third-party tag adds latency you cannot control."}]]}],["$","div","2",{"className":"border-b border-border pb-5 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg","children":"No CDN"}],["$","p",null,{"className":"mt-2 leading-relaxed text-fg-muted","children":"Serving static assets from a single origin server adds round-trip latency for visitors not near that server. Cloudflare is free for most sites and routes assets from edge locations geographically close to the visitor. Enable it before any other infrastructure change."}]]}],["$","div","3",{"className":"border-b border-border pb-5 last:border-0 last:pb-0","children":[["$","p",null,{"className":"font-semibold text-fg","children":"Slow server response (TTFB above 800ms)"}],["$","p",null,{"className":"mt-2 leading-relaxed text-fg-muted","children":"Time to First Byte above 800ms means the server itself is slow before the browser has received anything to render. Causes: shared hosting under load, unoptimised server-side rendering, no caching. Check TTFB in PageSpeed Insights. If it is above 800ms, hosting tier or server-side caching is the fix, not image compression."}]]}]]}]]}]
15:["$","section",null,{"className":"mt-6 rounded-md border border-border bg-bg-panel p-8","children":[["$","h2",null,{"className":"mb-4 text-2xl font-bold text-fg","children":"Fix sequence: highest priority first"}],["$","p",null,{"className":"leading-relaxed text-fg-muted","children":"Speed optimisation has diminishing returns. Getting from 6s to 3s is usually straightforward. Getting from 3s to 1.5s requires code splitting, critical CSS, and font subsetting. Start with the high-impact, low-effort fixes."}],["$","ol",null,{"className":"mt-5 space-y-3","children":[["$","li","0",{"className":"flex items-start gap-3 text-fg-muted","children":[["$","span",null,{"className":"shrink-0 font-bold text-accent","children":[1,"."]}],"Compress hero image to WebP at 80% quality"]}],["$","li","1",{"className":"flex items-start gap-3 text-fg-muted","children":[["$","span",null,{"className":"shrink-0 font-bold text-accent","children":[2,"."]}],"Add lazy loading to all below-fold images (loading=\"lazy\")"]}],["$","li","2",{"className":"flex items-start gap-3 text-fg-muted","children":[["$","span",null,{"className":"shrink-0 font-bold text-accent","children":[3,"."]}],"Enable Cloudflare or equivalent CDN"]}],["$","li","3",{"className":"flex items-start gap-3 text-fg-muted","children":[["$","span",null,{"className":"shrink-0 font-bold text-accent","children":[4,"."]}],"Defer or async-load all non-critical third-party scripts"]}],["$","li","4",{"className":"flex items-start gap-3 text-fg-muted","children":[["$","span",null,{"className":"shrink-0 font-bold text-accent","children":[5,"."]}],"Check TTFB - if above 800ms, address server response before frontend"]}],["$","li","5",{"className":"flex items-start gap-3 text-fg-muted","children":[["$","span",null,{"className":"shrink-0 font-bold text-accent","children":[6,"."]}],"Remove redirect chains (each redirect adds a full round-trip)"]}]]}],["$","p",null,{"className":"mt-4 text-sm text-fg-muted","children":"Re-run PageSpeed Insights after each change to confirm the LCP improvement before moving to the next fix."}]]}]
