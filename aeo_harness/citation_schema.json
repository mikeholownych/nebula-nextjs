{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["engine", "query", "timestamp", "answer", "citations"],
  "properties": {
    "engine": {"type":"string","minLength":1},
    "model": {"type":"string"},
    "query": {"type":"string","minLength":1},
    "timestamp": {"type":"string","format":"date-time"},
    "answer": {"type":"string"},
    "citations": {"type":"array","items":{"type":"object","required":["url"],"properties":{"url":{"type":"string","format":"uri"},"position":{"type":"integer","minimum":1}}}},
    "raw_response_sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
