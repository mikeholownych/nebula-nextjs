{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "prompt_set", "query_id", "engine", "model", "query", "timestamp", "answer", "citations", "raw_response_sha256"],
  "properties": {
    "run_id": {"type":"string","minLength":1},
    "prompt_set": {"type":"string","minLength":1},
    "query_id": {"type":"string","minLength":1},
    "engine": {"type":"string","minLength":1},
    "model": {"type":"string","minLength":1},
    "query": {"type":"string","minLength":1},
    "timestamp": {"type":"string","format":"date-time"},
    "answer": {"type":"string"},
    "citations": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["url"],"properties":{"url":{"type":"string","format":"uri"},"position":{"type":"integer","minimum":1}}}},
    "raw_response_sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"}
  }
}
