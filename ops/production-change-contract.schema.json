{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebulacomponents.com/schemas/production-change-contract.json",
  "title": "Nebula Production Change Contract",
  "description": "Required intent, risk, verification, and rollback contract for production changes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_id",
    "goal",
    "owner",
    "risk_class",
    "affected_lifecycles",
    "scope",
    "constraints",
    "assumptions",
    "tests",
    "verification",
    "rollback",
    "approval",
    "evidence"
  ],
  "properties": {
    "change_id": {"type": "string", "minLength": 3, "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "goal": {"type": "string", "minLength": 10},
    "owner": {"type": "string", "minLength": 2},
    "risk_class": {"enum": ["low", "medium", "high", "critical"]},
    "affected_lifecycles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "out_of_scope"],
      "properties": {
        "in_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "out_of_scope": {"type": "array", "items": {"type": "string"}}
      }
    },
    "constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative", "runtime"],
      "properties": {
        "positive": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "negative": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "runtime": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["done_when", "artifacts", "live_checks"],
      "properties": {
        "done_when": {"type": "string", "minLength": 10},
        "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "live_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "procedure", "evidence"],
      "properties": {
        "trigger": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "procedure": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence": {"type": "string", "minLength": 5}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "approver", "side_effects"],
      "properties": {
        "required": {"type": "boolean"},
        "approver": {"type": "string"},
        "side_effects": {"type": "array", "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "decision"],
      "properties": {
        "before": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "after": {"type": "array", "items": {"type": "string"}},
        "decision": {"enum": ["planned", "accepted", "rejected", "reverted"]}
      }
    }
  }
}
