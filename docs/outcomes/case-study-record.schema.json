{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebulacomponents.com/schemas/case-study-record.v1.json",
  "title": "Nebula Case Study Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "publication_status", "payment", "customer", "pre_intervention_audit", "intervention", "post_intervention_reaudit", "outcomes"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "publication_status": {"enum": ["internal_only", "review_pending", "approved_for_publication", "published"]},
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "paid_at", "amount_cents", "currency"],
      "properties": {
        "receipt_id": {"type": "string", "minLength": 1},
        "paid_at": {"type": "string", "format": "date"},
        "amount_cents": {"type": "integer", "minimum": 1},
        "currency": {"const": "USD"}
      }
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customer_id", "consent"],
      "properties": {
        "customer_id": {"type": "string", "minLength": 1},
        "consent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["granted"],
          "properties": {
            "granted": {"type": "boolean"},
            "granted_at": {"type": "string", "format": "date-time"},
            "scope": {"type": "string"}
          }
        }
      }
    },
    "pre_intervention_audit": {"$ref": "#/$defs/audit"},
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "description", "applied_at"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "applied_at": {"type": "string", "format": "date"}
      }
    },
    "post_intervention_reaudit": {
      "allOf": [
        {"$ref": "#/$defs/audit"},
        {"type": "object", "required": ["same_scope"], "properties": {"same_scope": {"const": true}}}
      ]
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "source_type"],
        "properties": {
          "kind": {"enum": ["measured_condition_change", "customer_reported_business_outcome"]},
          "source_type": {"enum": ["measured", "customer_reported"]},
          "claim": {"type": "string"},
          "percentage": {"type": "number", "minimum": 0, "maximum": 100},
          "numerator": {"type": "integer", "minimum": 0},
          "denominator": {"type": "integer", "minimum": 1},
          "window": {"type": "string", "minLength": 1},
          "source_reference": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {"if": {"required": ["percentage"]}, "then": {"required": ["numerator", "denominator", "window", "source_reference"]}},
          {"if": {"properties": {"kind": {"const": "measured_condition_change"}}}, "then": {"properties": {"source_type": {"const": "measured"}}}},
          {"if": {"properties": {"kind": {"const": "customer_reported_business_outcome"}}}, "then": {"properties": {"source_type": {"const": "customer_reported"}, "claim": {"minLength": 1}, "source_reference": {"minLength": 1}}}}
        ]
      }
    }
  },
  "$defs": {
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_id", "completed_at", "condition_id", "determination"],
      "properties": {
        "audit_id": {"type": "string", "minLength": 1},
        "completed_at": {"type": "string", "format": "date"},
        "condition_id": {"type": "string", "minLength": 1},
        "determination": {"enum": ["PASS", "FAIL", "INDETERMINATE", "NOT_APPLICABLE"]},
        "same_scope": {"type": "boolean"}
      }
    }
  }
}
