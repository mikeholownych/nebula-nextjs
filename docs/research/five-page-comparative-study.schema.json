{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebulacomponents.com/schemas/five-page-comparative-study.v1.json",
  "title": "Nebula Five-Page Comparative Study",
  "type": "object",
  "additionalProperties": false,
  "required": ["study_id", "status", "engine_version", "audit_conditions", "publication_decision", "pages", "limitations"],
  "properties": {
    "study_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "in_review", "approved", "published"]},
    "engine_version": {"type": "string", "minLength": 1},
    "audit_conditions": {"type": "string", "minLength": 1},
    "publication_decision": {"enum": ["blocked_pending_review", "approved", "rejected"]},
    "pages": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "source_type", "traffic_provenance", "selection_rationale", "captured_at", "evidence_package"],
        "properties": {
          "url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "source_type": {"const": "primary_public_source"},
          "traffic_provenance": {"enum": ["verified_paid", "publicly_inspectable", "unknown"]},
          "selection_rationale": {"type": "string", "minLength": 1},
          "captured_at": {"type": "string", "format": "date-time"},
          "evidence_package": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
