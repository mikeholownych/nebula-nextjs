# Customer Demand Signal Log
# Format: one JSON object per line. Append-only. Never edit or delete existing lines.
# Each line is one demand pattern observation.
#
# Schema:
# {
#   "signal_id":        "DS-YYYYMM-NNN",          // unique, assigned at recording
#   "recorded_at":      "YYYY-MM-DDTHH:MM:SSZ",    // UTC ISO 8601
#   "recorded_by":      "string",                   // operator who recorded it
#   "source_type":      "audit_reason_pattern | support_classification | interview | survey | behavior_analysis | external",
#   "observation_window": "YYYY-MM to YYYY-MM",     // collection period, not individual timestamp
#   "demand_provenance": "SPONTANEOUS | PROMPTED | DERIVED | UNKNOWN",
#                                                   // Provenance classification per opportunity-governance.md Layer 2.
#                                                   // SPONTANEOUS: customer described the problem without Nebula initiating
#                                                   // PROMPTED: customer responded to a Nebula-authored inquiry about this problem
#                                                   // DERIVED: signal originated from Nebula framing, content, or audit output
#                                                   // UNKNOWN: origin cannot be verified
#                                                   // Only SPONTANEOUS counts toward C5 independence.
#                                                   // UNKNOWN fails closed for any threshold requiring independence.
#   "independent_customer_count": N,                // Count of distinct economic buyers — not contacts, users, or accounts.
#                                                   // Multiple contacts/divisions of one company are ONE economic buyer.
#                                                   // If in doubt, record the lower bound. Never inflate.
#   "observation_count": N,                         // total observations, may exceed customer count
#   "independence_verified": true|false,            // were these from distinct sessions/sources?
#   "underlying_job":   "string",                   // the job-to-be-done in the customer's words or close paraphrase
#   "observed_workaround": "string or null",        // what customers are doing now instead
#   "economic_consequence": "string or null",       // observable cost or lost value in customer terms (no Nebula projection)
#   "evidence_refs":    ["string"],                 // references to evidence files, interview IDs, or external URLs
#   "pii_free_notes":   "string",                   // any additional context; must not contain email, name, company
#   "demand_state":     "observed | pattern | insufficient_data | invalidated",
#   "opportunity_id":   "OPP-YYYYMM-NNN or null"   // if this signal is linked to a gate assessment
# }
#
# Rules:
# 1. "independent_customer_count" must be a count of distinct economic buyers, not contacts.
#    Multiple people from the same company count as ONE. If in doubt, record the lower bound.
# 2. Three or more distinct economic buyers (SPONTANEOUS provenance) across two or more
#    distinct-customer sessions is the minimum threshold for demand_state: "pattern".
#    PROMPTED, DERIVED, and UNKNOWN signals do not count toward this threshold.
# 3. Customers reached through the same content campaign, the same Nebula inquiry,
#    the same event, the same Reddit thread, or the same Nebula-framed audit are NOT
#    independent for this criterion. Record them as PROMPTED or DERIVED.
# 4. OSS adoption metrics (GitHub stars, forks, issues, downloads) are NOT customer demand.
#    Do not record Citable OSS activity as commercial demand evidence.
# 5. economic_consequence must use the customer's own framing where possible.
#    Do not substitute Nebula's projected value.
# 6. This file must never contain email addresses, names, company names,
#    or any other personal identifiers. Use generic descriptions.
# 7. This file is the demand evidence record. The lead pipeline (lead_state.db)
#    is the operational pipeline. Do not conflate them.
#
# No entries yet. First entry will appear when a qualifying signal is observed.
